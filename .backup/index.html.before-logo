<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Minimal Ego — v2</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { background-color: #0b0d10; color: #e5e7eb; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    .poster-glow:hover { box-shadow: 0 10px 25px -5px rgba(250, 204, 21, 0.15); }
    input[type=range]::-webkit-slider-thumb {
      -webkit-appearance: none;
      height: 20px;
      width: 20px;
      border-radius: 50%;
      background: #facc15;
      cursor: pointer;
    }
    input[type=range]::-moz-range-thumb { height: 20px; width: 20px; border: 0; border-radius: 50%; background: #facc15; cursor: pointer; }
    button:focus-visible { outline: 2px solid #facc15; outline-offset: 3px; }
    button:disabled { opacity: 0.5; cursor: wait; }
    [hidden] { display: none !important; }
  </style>
</head>
<body class="min-h-screen pb-24">

  <header class="border-b border-zinc-800/80 bg-zinc-950/80 backdrop-blur sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 py-3.5 flex flex-wrap gap-3 items-center justify-between">
      <div class="flex items-center gap-3">
        <span class="text-lg font-bold tracking-tight text-white">MINIMAL<span class="text-yellow-400">EGO</span></span>
        <span class="text-[10px] px-2 py-0.5 rounded bg-zinc-800 text-zinc-400 font-mono">v2.0</span>
      </div>
      <nav class="flex items-center gap-1.5 sm:gap-2" aria-label="Sezioni film">
        <button onclick="switchTab('discover')" id="tab-discover" aria-current="page" class="px-3 py-1.5 text-xs font-medium rounded-md bg-yellow-400/10 text-yellow-400">Feed</button>
        <button onclick="switchTab('awards')" id="tab-awards" class="px-3 py-1.5 text-xs font-medium rounded-md text-zinc-400 hover:text-white">Scopri</button>
        <button onclick="switchTab('watchlist')" id="tab-watchlist" class="px-3 py-1.5 text-xs font-medium rounded-md text-zinc-400 hover:text-white">Watchlist (<span id="count-watchlist">0</span>)</button>
        <button onclick="switchTab('rated')" id="tab-rated" class="px-3 py-1.5 text-xs font-medium rounded-md text-zinc-400 hover:text-white">Rated (<span id="count-rated">0</span>)</button>
        <button onclick="switchTab('import')" id="tab-import" hidden class="px-3 py-1.5 text-xs font-medium rounded-md text-zinc-400 hover:text-white">Importa</button>
      </nav>
      <div id="account-area" class="flex items-center gap-2 text-xs">
        <button onclick="openAuth('login')" id="btn-open-login" class="px-3 py-1.5 bg-yellow-400 text-black font-semibold rounded-md hover:bg-yellow-300">Accedi</button>
        <span id="account-email" hidden class="max-w-[12rem] truncate text-zinc-400"></span>
        <button onclick="handleLogout()" id="btn-logout" hidden class="px-3 py-1.5 bg-zinc-900 border border-zinc-700 text-zinc-200 rounded-md hover:bg-zinc-800">Esci</button>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 pt-6">
    <section id="search-section" class="mb-6 space-y-3">
      <div class="flex gap-2">
        <input type="search" id="search-input" aria-label="Cerca un film" maxlength="200" placeholder="Cerca un film su TMDB..."
          class="min-w-0 flex-1 bg-zinc-900 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm text-white focus:outline-none focus:border-yellow-400 transition"
          onkeydown="if(event.key === 'Enter') executeSearch()">
        <button onclick="executeSearch()" class="px-4 py-2.5 bg-yellow-400 text-black font-semibold text-xs rounded-lg hover:bg-yellow-300 transition">Cerca</button>
      </div>
    </section>
    <div id="filter-bar" class="mb-4 space-y-2 rounded-lg border border-zinc-800 bg-zinc-950/60 p-3"></div>
    <div id="search-status" class="text-xs text-zinc-500 mb-4" role="status" aria-live="polite"></div>
    <div id="library-status" class="text-xs text-amber-400 mb-4" role="status" aria-live="polite"></div>
    <div id="movie-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4"></div>
    <div id="pager" class="mt-6 flex items-center justify-center gap-3 text-xs"></div>
    <section id="import-section" hidden class="max-w-4xl" aria-labelledby="import-title">
      <h2 id="import-title" class="text-base font-bold text-white mb-1">Importa i tuoi film da CSV</h2>
      <p class="text-xs text-zinc-400 mb-5">Carica un file con i film visti, i voti e la wishlist. Prima di salvare vedrai un'anteprima e potrai correggere i film non riconosciuti.</p>
      <div id="import-content"></div>
    </section>
    <p class="mt-8 text-[10px] text-zinc-500">Watchlist, voti e note sono salvati su Netlify e associati al tuo account. Le selezioni festival sono ricerche esemplificative, non archivi completi.</p>
    <p class="mt-2 text-[10px] text-zinc-500">Dati e immagini forniti da TMDB. Questo prodotto utilizza l'API TMDB ma non è approvato o certificato da TMDB.</p>
  </main>

  <div id="info-modal" hidden role="dialog" aria-modal="true" aria-labelledby="info-title" class="fixed inset-0 z-50 flex items-center justify-center bg-black/75 p-3 sm:p-6" onclick="if(event.target===this)closeInfo()">
    <div class="flex w-full max-w-3xl flex-col overflow-hidden rounded-xl border border-zinc-700 bg-zinc-950 shadow-2xl" style="max-height:min(88vh,88dvh)">
      <div class="flex shrink-0 items-center justify-between border-b border-zinc-800 px-4 py-2">
        <span class="text-xs uppercase tracking-wide text-zinc-400">Scheda film</span>
        <button type="button" onclick="closeInfo()" aria-label="Chiudi scheda" class="flex h-10 w-10 items-center justify-center rounded-full bg-zinc-800 text-lg text-white hover:bg-zinc-700">✕</button>
      </div>
      <div id="info-body" class="min-h-0 flex-1 overflow-y-auto p-4 sm:p-5"></div>
      <div class="shrink-0 border-t border-zinc-800 p-3 sm:hidden"><button type="button" onclick="closeInfo()" class="w-full rounded-lg bg-zinc-800 py-3 text-sm font-medium text-white">Chiudi</button></div>
    </div>
  </div>

  <div id="rating-drawer" role="dialog" aria-modal="true" aria-labelledby="drawer-title" aria-hidden="true" inert
    class="fixed inset-y-0 right-0 w-full sm:w-96 bg-zinc-950 border-l border-zinc-800 p-6 z-50 transform translate-x-full transition-transform duration-300 flex flex-col justify-between shadow-2xl overflow-y-auto">
    <div>
      <div class="flex justify-between items-start mb-4">
        <h3 id="drawer-title" class="font-bold text-base text-white line-clamp-1">Dettagli Film</h3>
        <button id="drawer-close" onclick="closeDrawer()" aria-label="Chiudi dettagli" class="text-zinc-500 hover:text-white text-lg">✕</button>
      </div>
      <p id="drawer-meta" class="text-[11px] text-zinc-500 -mt-2 mb-3" hidden></p>
      <img id="drawer-poster" alt="Locandina del film" class="w-full h-44 object-cover rounded-lg mb-4 bg-zinc-900 border border-zinc-800">
      <p id="drawer-overview" class="text-xs text-zinc-400 mb-6 line-clamp-3 leading-relaxed"></p>
      <div class="space-y-4">
        <div class="flex justify-between items-baseline">
          <label for="rating-slider" class="text-xs font-semibold uppercase tracking-wider text-zinc-400">Il tuo voto</label>
          <span id="rating-display" class="text-3xl font-extrabold text-yellow-400 font-mono">7.5</span>
        </div>
        <input type="range" id="rating-slider" min="1.0" max="10.0" step="0.1" value="7.5"
          class="w-full h-1.5 bg-zinc-800 rounded-lg appearance-none cursor-pointer" oninput="updateSliderDisplay(this.value)">
        <div class="grid grid-cols-4 gap-1.5 pt-1">
          <button onclick="adjustRating(-0.5)" class="py-1 bg-zinc-900 border border-zinc-800 rounded text-xs text-zinc-300 hover:border-zinc-700">-0.5</button>
          <button onclick="adjustRating(-0.1)" class="py-1 bg-zinc-900 border border-zinc-800 rounded text-xs text-zinc-300 hover:border-zinc-700">-0.1</button>
          <button onclick="adjustRating(0.1)" class="py-1 bg-zinc-900 border border-zinc-800 rounded text-xs text-zinc-300 hover:border-zinc-700">+0.1</button>
          <button onclick="adjustRating(0.5)" class="py-1 bg-zinc-900 border border-zinc-800 rounded text-xs text-zinc-300 hover:border-zinc-700">+0.5</button>
        </div>
        <textarea id="drawer-notes" aria-label="Note personali" maxlength="5000" placeholder="Note personali, regia, sceneggiatura..." rows="3"
          class="w-full mt-4 bg-zinc-900 border border-zinc-800 rounded-lg p-3 text-xs text-white focus:outline-none focus:border-yellow-400"></textarea>
      </div>
    </div>
    <div class="pt-4 mt-4 border-t border-zinc-800">
      <p id="drawer-status" class="text-xs text-amber-400 mb-3" role="status" aria-live="polite"></p>
      <div class="flex gap-2">
        <button onclick="saveRating()" id="btn-save-rating" class="flex-1 py-2.5 bg-yellow-400 text-black font-semibold text-xs rounded-lg hover:bg-yellow-300 transition">Salva Voto</button>
        <button onclick="toggleWatchlistCurrent()" id="btn-watchlist-drawer" class="px-4 py-2.5 bg-zinc-900 border border-zinc-700 text-xs text-zinc-200 rounded-lg hover:bg-zinc-800">+ Watchlist</button>
      </div>
    </div>
  </div>

  <div id="auth-modal" role="dialog" aria-modal="true" aria-labelledby="auth-title" aria-hidden="true" inert hidden
    class="fixed inset-0 z-[60] flex items-center justify-center bg-black/70 backdrop-blur-sm p-4" onclick="if(event.target === this) closeAuth()">
    <div class="w-full max-w-sm bg-zinc-950 border border-zinc-800 rounded-xl p-6 shadow-2xl">
      <div class="flex justify-between items-start mb-1">
        <h3 id="auth-title" class="font-bold text-base text-white">Accedi</h3>
        <button id="auth-close" onclick="closeAuth()" aria-label="Chiudi" class="text-zinc-500 hover:text-white text-lg">✕</button>
      </div>
      <p id="auth-subtitle" class="text-xs text-zinc-400 mb-5"></p>
      <form id="auth-form" class="space-y-3" onsubmit="event.preventDefault(); submitAuth()" novalidate>
        <div id="auth-field-email">
          <label for="auth-email" class="block text-[11px] font-semibold uppercase tracking-wider text-zinc-400 mb-1">Email</label>
          <input type="email" id="auth-email" autocomplete="email" maxlength="254"
            class="w-full bg-zinc-900 border border-zinc-800 rounded-lg px-3 py-2.5 text-sm text-white focus:outline-none focus:border-yellow-400">
        </div>
        <div id="auth-field-password">
          <label for="auth-password" id="auth-password-label" class="block text-[11px] font-semibold uppercase tracking-wider text-zinc-400 mb-1">Password</label>
          <input type="password" id="auth-password" autocomplete="current-password" maxlength="200"
            class="w-full bg-zinc-900 border border-zinc-800 rounded-lg px-3 py-2.5 text-sm text-white focus:outline-none focus:border-yellow-400">
        </div>
        <p id="auth-message" class="text-xs min-h-[1rem]" role="status" aria-live="polite"></p>
        <button type="submit" id="auth-submit" class="w-full py-2.5 bg-yellow-400 text-black font-semibold text-xs rounded-lg hover:bg-yellow-300 transition">Accedi</button>
      </form>
      <div id="auth-links" class="mt-4 flex flex-col gap-2 text-xs text-zinc-400"></div>
    </div>
  </div>

  <script src="/auth.js"></script>
  <script>
    const TMDB_IMG_URL = "https://image.tmdb.org/t/p/w500";
    const EMPTY_POSTER = "data:image/svg+xml," + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" width="500" height="750" viewBox="0 0 500 750"><rect width="500" height="750" fill="#18181b"/><text x="250" y="375" text-anchor="middle" fill="#71717a" font-family="sans-serif" font-size="24">Locandina non disponibile</text></svg>');
    let currentMovies = [];
    let selectedMovie = null;
    let library = { watchlist: [], ratings: {}, movies: [] };
    let activeTab = 'discover';
    let libraryReady = false;
    let saving = false;
    let searchRequest = 0;
    let previousFocus = null;
    let currentUser = null;
    let feedFilter = 'all';
    let feedPeriod = '3m';
    let feedGenre = 'all';
    let feedSort = 'popularity';
    let feedPage = 1;
    let feedTotal = 0;
    let feedPool = null;
    let feedPoolKey = '';
    let feedMode = false;
    let ratedSort = 'score';
    let ratedYear = 'all';
    let watchlistSort = 'added';
    let awardsFilter = 'all';
    let awardsYear = 'all';
    let awardsOutcome = 'all';
    let awardsCat = 'all';
    let awardsSort = 'auto';
    let awardsRows = null;
    let awardsSources = {};
    const awardsFilms = new Map();
    const Auth = window.MinimalEgoAuth;

    async function fetchJSON(url, options = {}) {
      const response = await fetch(url, { credentials: 'same-origin', ...options });
      let data;
      try {
        data = await response.json();
      } catch {
        throw new Error('Risposta del server non valida. Apri il sito tramite Netlify.');
      }
      if (response.status === 401 && currentUser) {
        throw new Error('La sessione è scaduta. Esci e accedi di nuovo per continuare.');
      }
      if (!response.ok) throw new Error(data.error || 'Richiesta non riuscita. Riprova.');
      return data;
    }

    async function apiFetch(endpoint) {
      return fetchJSON(`/api/tmdb${endpoint}`);
    }

    async function loadCatalog(endpoint, loading, success) {
      activeTab = 'discover';
      feedMode = typeof endpoint === 'function';
      updateTabs();
      const requestId = ++searchRequest;
      setStatus(loading);
      const grid = document.getElementById('movie-grid');
      grid.setAttribute('aria-busy', 'true');
      grid.innerHTML = Array.from({ length: 6 }, () => '<div class="rounded-lg border border-zinc-800 bg-zinc-900 animate-pulse"><div class="aspect-[2/3] bg-zinc-800"></div><div class="h-16"></div></div>').join('');
      try {
        const data = typeof endpoint === 'function' ? await endpoint() : await apiFetch(endpoint);
        if (requestId !== searchRequest || activeTab !== 'discover') return;
        currentMovies = Array.isArray(data.results) ? data.results : [];
        renderActiveMovies();
        setStatus(typeof success === 'function' ? success(currentMovies.length) : success);
      } catch (error) {
        if (requestId !== searchRequest || activeTab !== 'discover') return;
        currentMovies = [];
        renderActiveMovies();
        setStatus(error.message || 'Errore di caricamento.');
      } finally {
        if (requestId === searchRequest) grid.removeAttribute('aria-busy');
      }
    }

    function updateFeedButtons() { renderFilterBar(); }

    const FEED_PERIODS = { '3m': ['Ultimi 3 mesi', 92], '1y': ['Ultimo anno', 365], '2y': ['Ultimi 2 anni', 730] };
    const FEED_GENRES = [[28, 'Azione'], [12, 'Avventura'], [16, 'Animazione'], [35, 'Commedia'], [80, 'Crime'], [99, 'Documentario'], [18, 'Drammatico'], [10751, 'Famiglia'], [14, 'Fantasy'], [36, 'Storico'], [27, 'Horror'], [10402, 'Musica'], [9648, 'Mistero'], [10749, 'Romantico'], [878, 'Fantascienza'], [53, 'Thriller'], [10752, 'Guerra'], [37, 'Western']];
    const GENRE_NAMES = Object.fromEntries(FEED_GENRES.concat([[10770, 'Film TV']]));
    const FEED_PAGE_SIZE = 25;
    const MIN_FEED_RATING = 5.5;

    function dateOffset(days) {
      const d = new Date(); d.setDate(d.getDate() + days);
      return d.toISOString().slice(0, 10);
    }

    function genreText(movie) {
      let names = [];
      if (Array.isArray(movie.genre_ids)) names = movie.genre_ids.map((id) => GENRE_NAMES[id]);
      else if (Array.isArray(movie.genres)) names = movie.genres.map((g) => (typeof g === 'string' ? g : g.name));
      else if (movie.genres) names = String(movie.genres).split(/[,|/;]+/).map((item) => item.trim());
      return names.filter(Boolean).slice(0, 2).join(', ');
    }

    function feedSlice() {
      let list = (feedPool || []).filter((movie) => !library.watchlist.includes(movie.id) && !library.ratings[movie.id]);
      if (feedSort === 'recent') list = list.slice().sort((a, b) => String(b.release_date || '').localeCompare(String(a.release_date || '')));
      else if (feedSort === 'rating') list = list.slice().sort((a, b) => Number(b.vote_average || 0) - Number(a.vote_average || 0));
      feedTotal = list.length;
      const pages = Math.max(1, Math.ceil(list.length / FEED_PAGE_SIZE));
      feedPage = Math.min(Math.max(1, feedPage), pages);
      return list.slice((feedPage - 1) * FEED_PAGE_SIZE, feedPage * FEED_PAGE_SIZE);
    }

    function setFeed(key, value) {
      if (key === 'period') feedPeriod = value;
      if (key === 'genre') feedGenre = value;
      if (key === 'sort') { feedSort = value; feedPage = 1; renderFilterBar(); renderActiveMovies(); return; }
      return loadFeed();
    }

    function setFeedPage(page) {
      feedPage = page;
      renderActiveMovies();
      const [period] = FEED_PERIODS[feedPeriod];
      setStatus(`${feedTotal} film consigliati (${period.toLowerCase()}) · pagina ${feedPage} di ${Math.max(1, Math.ceil(feedTotal / FEED_PAGE_SIZE))}.`);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function renderPager() {
      const pager = document.getElementById('pager');
      if (!pager) return;
      const pages = Math.max(1, Math.ceil(feedTotal / FEED_PAGE_SIZE));
      if (activeTab !== 'discover' || !feedMode || pages < 2) { pager.innerHTML = ''; return; }
      const button = (label, page, disabled) => `<button type="button" ${disabled ? 'disabled' : ''} onclick="setFeedPage(${page})" class="px-3 py-2 rounded-md border border-zinc-600 bg-zinc-900 text-zinc-100 hover:border-yellow-400 disabled:opacity-40 disabled:cursor-not-allowed">${label}</button>`;
      pager.innerHTML = `${button('\u2190 Precedente', feedPage - 1, feedPage <= 1)}<span class="text-zinc-300">Pagina ${feedPage} di ${pages}</span>${button('Successiva \u2192', feedPage + 1, feedPage >= pages)}`;
    }

    function loadFeed() {
      feedPage = 1;
      const [periodLabel, days] = FEED_PERIODS[feedPeriod] || FEED_PERIODS['3m'];
      const genreLabel = feedGenre === 'all' ? '' : ` \u00b7 ${GENRE_NAMES[feedGenre] || ''}`;
      const key = `${feedPeriod}|${feedGenre}`;
      const fetchPool = async () => {
        if (!feedPool || feedPoolKey !== key) {
          const pages = await Promise.all([1, 2, 3, 4, 5].map((page) => {
            const params = new URLSearchParams({ sort_by: 'popularity.desc', 'primary_release_date.gte': dateOffset(-days), 'primary_release_date.lte': dateOffset(30), page: String(page) });
            if (feedGenre !== 'all') params.set('with_genres', feedGenre);
            return apiFetch(`/discover/movie?${params}`).catch(() => ({ results: [] }));
          }));
          const seen = new Set();
          feedPool = pages.flatMap((page) => page.results || [])
            .filter((movie) => movie.poster_path && !seen.has(movie.id) && seen.add(movie.id))
            .filter((movie) => !(movie.vote_count >= 20 && movie.vote_average < MIN_FEED_RATING));
          feedPoolKey = key;
        }
        return { results: feedSlice() };
      };
      return loadCatalog(fetchPool, 'Caricamento suggerimenti...', () => {
        const pages = Math.max(1, Math.ceil(feedTotal / FEED_PAGE_SIZE));
        return `${feedTotal} film consigliati (${periodLabel.toLowerCase()}${genreLabel}) \u00b7 pagina ${feedPage} di ${pages}. Nascosti i film gi\u00e0 nella tua libreria e quelli con rating TMDB sotto ${MIN_FEED_RATING}.`;
      });
    }

    function loadTrending() { return loadFeed('all'); }

    const AWARD_SHORT = { oscar: 'Oscar', cannes: 'Cannes', venice: 'Venezia', berlin: 'Berlino', donatello: 'David', sundance: 'Sundance' };
    const GROUP_LABEL = { film: 'Miglior film', director: 'Regia', acting: 'Interpretazione', screenplay: 'Sceneggiatura', international: 'Film internazionale', jury: 'Premio giuria' };
    const GROUP_WEIGHT = { film: 100, director: 90, acting: 80, screenplay: 75, international: 70, jury: 60 };

    function setAwards(key, value) {
      if (key === 'festival') awardsFilter = value;
      if (key === 'year') awardsYear = value;
      if (key === 'outcome') awardsOutcome = value;
      if (key === 'cat') awardsCat = value;
      if (key === 'sort') awardsSort = value;
      return loadAwards();
    }

    function rowWeight(row) {
      return (GROUP_WEIGHT[row.group] || 50) * (row.status === 'win' ? 1 : 0.4);
    }

    function awardsFilteredRows() {
      const minYear = new Date().getFullYear() - 4;
      return (awardsRows || []).filter((row) => row.year >= minYear
        && (awardsFilter === 'all' || row.festival === awardsFilter)
        && (awardsYear === 'all' || String(row.year) === awardsYear)
        && (awardsOutcome === 'all' || row.status === awardsOutcome)
        && (awardsCat === 'all' || row.group === awardsCat));
    }

    function splitNames(value) {
      return String(value || '').split(/[,|/;]+/).map((item) => item.trim().toLowerCase()).filter(Boolean);
    }

    function buildProfile() {
      const rated = Object.entries(library.ratings).map(([id, rating]) => ({ movie: library.movies.find((m) => m.id === Number(id)), score: Number(rating.score) }))
        .filter((item) => item.movie && item.score > 0);
      if (!rated.length) return null;
      const mean = rated.reduce((total, item) => total + item.score, 0) / rated.length;
      const tally = (keys) => {
        const map = new Map();
        rated.forEach((item) => keys(item.movie).forEach((key) => {
          const entry = map.get(key) || { sum: 0, n: 0 };
          entry.sum += item.score; entry.n += 1; map.set(key, entry);
        }));
        return map;
      };
      return { mean, directors: tally((m) => splitNames(m.director)), genres: tally((m) => splitNames(m.genres)), countries: tally((m) => splitNames(m.country)) };
    }

    function affinity(map, keys, mean) {
      const found = keys.map((key) => {
        const entry = map.get(key);
        if (!entry) return null;
        const avg = entry.sum / entry.n;
        return { key, avg, value: Math.max(-1, Math.min(1, ((avg - mean) / 3) * (entry.n / (entry.n + 1)))) };
      }).filter(Boolean);
      if (!found.length) return { value: null, best: null };
      return { value: found.reduce((t, f) => t + f.value, 0) / found.length, best: found.sort((a, b) => b.value - a.value)[0] };
    }

    function matchScore(movie, profile, prize) {
      if (!profile) return null;
      const low = (list) => (list || []).map((item) => String(item).toLowerCase());
      const dir = affinity(profile.directors, low(movie.directors), profile.mean);
      const gen = affinity(profile.genres, low(movie.genres), profile.mean);
      const cou = affinity(profile.countries, low(movie.countries), profile.mean);
      const quality = Math.max(-1, Math.min(1, (Number(movie.vote_average || 0) - 6.5) / 2));
      const award = Math.min(1, prize / 100);
      const raw = 0.15 * quality + 0.15 * award + 0.35 * (dir.value ?? 0) + 0.25 * (gen.value ?? 0) + 0.10 * (cou.value ?? 0) + 0.05;
      const score = Math.round(Math.max(0, Math.min(100, 50 + raw * 70)));
      let reason = 'Premiato e ben valutato su TMDB';
      if (dir.best && dir.value > 0.1) reason = `Regia di ${movie.directors.find((n) => n.toLowerCase() === dir.best.key) || dir.best.key}: media dei tuoi voti ${dir.best.avg.toFixed(1)}`;
      else if (gen.best && gen.value > 0.1) reason = `Genere che apprezzi: ${gen.best.key} (media ${gen.best.avg.toFixed(1)})`;
      else if (quality > 0.5) reason = 'Molto apprezzato su TMDB';
      return { score, reason };
    }

    function awardsView(includeOwned = false) {
      const byFilm = new Map();
      awardsFilteredRows().forEach((row) => byFilm.set(row.tmdb, (byFilm.get(row.tmdb) || []).concat(row)));
      const profile = buildProfile();
      const list = [];
      byFilm.forEach((rows, id) => {
        const film = awardsFilms.get(id);
        if (!film) return;
        if (!includeOwned && (library.watchlist.includes(id) || library.ratings[id])) return;
        rows.sort((a, b) => rowWeight(b) - rowWeight(a));
        const prize = rows.reduce((total, row, index) => total + (index === 0 ? rowWeight(row) : 5), 0);
        const movie = { ...film, prize,
          award: { win: rows.some((row) => row.status === 'win'), label: AWARD_SHORT[rows[0].festival], extra: rows.length - 1 },
          award_lines: rows.map((row) => `${row.status === 'win' ? '🏆' : '◎'} ${AWARD_SHORT[row.festival]} ${row.year} · ${GROUP_LABEL[row.group]} (${row.status === 'win' ? 'vincitore' : 'nomination'})`) };
        const match = matchScore(movie, profile, prize);
        movie.match = match ? match.score : null;
        movie.reason = match ? match.reason : '';
        list.push(movie);
      });
      const sort = awardsSort === 'auto' ? (currentUser ? 'foryou' : 'prize') : awardsSort;
      list.sort((a, b) => sort === 'foryou' ? ((b.match ?? -1) - (a.match ?? -1)) || (b.prize - a.prize)
        : sort === 'tmdb' ? Number(b.vote_average || 0) - Number(a.vote_average || 0)
        : sort === 'year' ? String(b.release_date || '').localeCompare(String(a.release_date || ''))
        : b.prize - a.prize);
      return list;
    }

    async function loadAwards() {
      renderFilterBar();
      const requestId = ++searchRequest;
      const stale = () => requestId !== searchRequest || activeTab !== 'awards';
      setStatus('Caricamento film premiati...');
      try {
        if (!awardsRows) {
          const data = await fetchJSON('/api/awards');
          awardsRows = Array.isArray(data.rows) ? data.rows : [];
          awardsSources = data.sources || {};
        }
        if (stale()) return;
        const ids = [...new Set(awardsFilteredRows().map((row) => row.tmdb))]
          .filter((id) => !awardsFilms.has(id) && !library.watchlist.includes(id) && !library.ratings[id]);
        for (let i = 0; i < ids.length; i += 30) {
          const chunk = ids.slice(i, i + 30);
          const data = await fetchJSON(`/api/awards/films?ids=${chunk.join(',')}`);
          (data.films || []).forEach((film) => awardsFilms.set(film.id, film));
          if (stale()) return;
          renderActiveMovies();
          if (i + 30 < ids.length) setStatus(`Caricamento film premiati... ${Math.min(i + 30, ids.length)}/${ids.length}`);
        }
        renderActiveMovies();
        const shown = visibleMovies().length;
        const total = currentMovies.length;
        const sourceNote = Object.entries(awardsSources).filter(([, source]) => source !== 'wikidata').map(([key, source]) => `${AWARD_SHORT[key]}: ${source === 'curated' ? 'elenco manuale' : 'nessun dato'}`).join(', ');
        setStatus(`${shown} film premiati.${total > shown ? ` ${total - shown} nascosti perché già nella tua libreria.` : ''}${sourceNote ? ` Fonti limitate: ${sourceNote}.` : ''}`);
      } catch (error) {
        if (stale()) return;
        currentMovies = []; renderActiveMovies(); setStatus(error.message || 'Errore di caricamento.');
      }
    }

    function renderFilterBar() {
      const bar = document.getElementById('filter-bar');
      if (!bar) return;
      const chip = (label, active, action) => `<button type="button" onclick="${action}" aria-pressed="${active}" class="px-3 py-1.5 rounded-full text-xs font-medium whitespace-nowrap border transition ${active ? 'bg-yellow-400 text-black border-yellow-400' : 'bg-zinc-900 text-zinc-200 border-zinc-600 hover:border-yellow-400 hover:text-white'}">${label}</button>`;
      const row = (title, chips) => `<div class="flex items-center gap-2 overflow-x-auto pb-1"><span class="w-16 shrink-0 text-[11px] uppercase tracking-wide text-zinc-400">${title}</span>${chips}</div>`;
      const thisYear = new Date().getFullYear();
      const years = [0, 1, 2, 3, 4].map((i) => String(thisYear - i));
      let html = '';
      if (activeTab === 'discover') {
        const select = (label, value, options, action) => `<label class="flex items-center gap-2 text-xs text-zinc-300">${label}<select onchange="${action}" class="rounded-md border border-zinc-600 bg-zinc-900 px-2 py-1.5 text-xs text-zinc-100 focus:border-yellow-400 focus:outline-none">${options.map(([v, l]) => `<option value="${v}" ${String(value) === String(v) ? 'selected' : ''}>${l}</option>`).join('')}</select></label>`;
        html = feedMode ? `<div class="flex flex-wrap items-center gap-3">`
          + select('Periodo', feedPeriod, Object.entries(FEED_PERIODS).map(([v, [l]]) => [v, l]), "setFeed('period',this.value)")
          + select('Genere', feedGenre, [['all', 'Tutti i generi'], ...FEED_GENRES], "setFeed('genre',this.value)")
          + select('Ordina', feedSort, [['popularity', 'Popolarit\u00e0'], ['recent', 'Pi\u00f9 recenti'], ['rating', 'Rating TMDB']], "setFeed('sort',this.value)")
          + `</div>` : '';
      } else if (activeTab === 'awards') {
        const pick = (key, current) => (v) => `setAwards('${key}','${v}')`;
        const rowOf = (title, key, current, items) => row(title, items.map(([v, l]) => chip(l, current === v, `setAwards('${key}','${v}')`)).join(''));
        const sortNow = awardsSort === 'auto' ? (currentUser ? 'foryou' : 'prize') : awardsSort;
        const sorts = [...(currentUser ? [['foryou', 'Per te']] : []), ['prize', 'Premio'], ['tmdb', 'Rating TMDB'], ['year', 'Uscita']];
        html = rowOf('Festival', 'festival', awardsFilter, [['all', 'Tutti'], ['oscar', 'Oscar'], ['cannes', 'Cannes'], ['venice', 'Venezia'], ['berlin', 'Berlino'], ['donatello', 'David'], ['sundance', 'Sundance']])
          + rowOf('Anno', 'year', awardsYear, [['all', 'Tutti'], ...years.map((y) => [y, y])])
          + rowOf('Esito', 'outcome', awardsOutcome, [['all', 'Tutti'], ['win', '🏆 Vincitori'], ['nom', '◎ Nomination']])
          + rowOf('Categoria', 'cat', awardsCat, [['all', 'Tutte'], ['film', 'Film'], ['director', 'Regia'], ['acting', 'Interpretazione'], ['screenplay', 'Sceneggiatura'], ['international', 'Internazionale'], ['jury', 'Giuria']])
          + rowOf('Ordina', 'sort', sortNow, sorts);
      } else if (activeTab === 'watchlist') {
        const sorts = [['added', 'Data di aggiunta'], ['tmdb', 'Rating TMDB'], ['year', 'Anno']];
        html = row('Ordina', sorts.map(([v, l]) => chip(l, watchlistSort === v, `watchlistSort='${v}';renderFilterBar();renderActiveMovies()`)).join(''));
      } else if (activeTab === 'rated') {
        const sorts = [['score', 'Punteggio'], ['director', 'Regista']];
        html = row('Ordina', sorts.map(([v, l]) => chip(l, ratedSort === v, `ratedSort='${v}';renderFilterBar();renderActiveMovies()`)).join(''))
          + row('Voti', [['all', 'All time'], ...years.map((y) => [y, y])].map(([v, l]) => chip(l, ratedYear === v, `ratedYear='${v}';renderFilterBar();renderActiveMovies()`)).join(''));
      }
      bar.innerHTML = html;
      bar.hidden = !html;
    }

    function updateFilterBars() {
      renderFilterBar();
    }

    function loadFestival(festival) {
      const query = festival === 'Cannes' ? 'Anora' : 'The Room Next Door';
      return loadCatalog(`/search/movie?query=${encodeURIComponent(query)}&language=it-IT`,
        `Caricamento selezione ${festival}...`, `Selezione esemplificativa ${festival}: ${query}.`);
    }

    function executeSearch() {
      const query = document.getElementById('search-input').value.trim();
      if (!query) return loadTrending();
      return loadCatalog(`/search/movie?query=${encodeURIComponent(query)}&language=it-IT&include_adult=false`,
        `Ricerca: "${query}"...`, (count) => `Trovati ${count} risultati.`);
    }

    function setStatus(text) {
      document.getElementById('search-status').textContent = text;
    }

    function escapeHTML(value) {
      return String(value ?? '').replace(/[&<>"']/g, (character) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
      })[character]);
    }

    function posterURL(path) {
      return typeof path === 'string' && /^\/[a-zA-Z0-9_.-]+$/.test(path) ? `${TMDB_IMG_URL}${path}` : EMPTY_POSTER;
    }

    function visibleMovies() {
      if (activeTab === 'watchlist') {
        const list = library.movies.filter((movie) => library.watchlist.includes(movie.id));
        return list.sort((a, b) => watchlistSort === 'tmdb' ? Number(b.external_rating || b.vote_average || 0) - Number(a.external_rating || a.vote_average || 0) : watchlistSort === 'year' ? Number(b.year || movieYear(b) || 0) - Number(a.year || movieYear(a) || 0) : new Date(b.added_at || 0) - new Date(a.added_at || 0));
      }
      if (activeTab === 'rated') {
        let list = library.movies.filter((movie) => library.ratings[movie.id]);
        if (ratedYear !== 'all') list = list.filter((movie) => String(library.ratings[movie.id]?.watched_at || movie.added_at || '').slice(0, 4) === ratedYear);
        return list.sort((a, b) => ratedSort === 'director' ? String(a.director || 'zzz').localeCompare(String(b.director || 'zzz')) || Number(library.ratings[b.id]?.score || 0) - Number(library.ratings[a.id]?.score || 0) : Number(library.ratings[b.id]?.score || 0) - Number(library.ratings[a.id]?.score || 0));
      }
      if (activeTab === 'awards') { currentMovies = awardsView(true); return currentMovies.filter((movie) => !library.watchlist.includes(movie.id) && !library.ratings[movie.id]); }
      if (feedMode) currentMovies = feedSlice();
      return currentMovies;
    }

    function renderActiveMovies() {
      renderMovies(visibleMovies());
      renderPager();
    }

    function renderMovies(list) {
      const grid = document.getElementById('movie-grid');
      grid.innerHTML = '';
      updateCounters();
      if (!currentUser && !['discover', 'awards'].includes(activeTab)) {
        grid.innerHTML = `<div class="col-span-full py-12 text-center text-xs text-zinc-500">Accedi per vedere la tua ${activeTab === 'watchlist' ? 'watchlist' : 'lista dei film votati'}.
          <div class="mt-3"><button onclick="openAuth('login')" class="px-3 py-1.5 bg-yellow-400 text-black font-semibold rounded-md hover:bg-yellow-300">Accedi</button></div></div>`;
        return;
      }
      if (!list.length) {
        const message = activeTab === 'watchlist' ? 'La tua watchlist è vuota. Aggiungi un film dal catalogo.'
          : activeTab === 'rated' ? 'Non hai ancora votato film. Scegli un film dal catalogo.' : 'Nessun film trovato.';
        grid.innerHTML = `<div class="col-span-full py-12 text-center text-xs text-zinc-500">${message}</div>`;
        return;
      }
      list.forEach((movie) => {
        if (!Number.isSafeInteger(movie.id) || movie.id < 1) return;
        const isWatchlisted = library.watchlist.includes(movie.id);
        const rating = library.ratings[movie.id]?.score;
        const tmdbScore = Number(movie.vote_average ?? movie.external_rating ?? 0);
        const tmdbBadge = tmdbScore > 0 && movie.vote_count !== 0 ? `<span class="absolute bottom-2 left-2 px-1.5 py-0.5 rounded bg-black/75 text-white font-mono text-[11px]" title="Rating TMDB">★ ${tmdbScore.toFixed(1)}</span>` : '';
        const awardBadge = movie.award ? `<span class="absolute bottom-2 right-2 px-1.5 py-0.5 rounded ${movie.award.win ? 'bg-yellow-400 text-black' : 'bg-zinc-900/90 text-zinc-100 border border-zinc-500'} text-[10px] font-semibold" title="${escapeHTML((movie.award_lines || []).join(' | '))}">${movie.award.win ? '🏆' : '◎'} ${escapeHTML(movie.award.label)}${movie.award.extra > 0 ? ` +${movie.award.extra}` : ''}</span>` : '';
        const matchBadge = movie.match != null && rating == null ? `<span class="absolute top-2 left-2 px-1.5 py-0.5 rounded bg-emerald-400 text-black font-bold text-[10px]" title="${escapeHTML(movie.reason || '')}">Per te ${movie.match}</span>` : '';
        const poster = posterURL(movie.poster_path);
        const title = escapeHTML(movie.title);
        const year = escapeHTML(movieYear(movie));
        const genreLabel = escapeHTML(genreText(movie));
        const card = document.createElement('div');
        card.className = 'group relative bg-zinc-900 border border-zinc-800/80 rounded-lg overflow-hidden flex flex-col poster-glow transition';
        card.innerHTML = `
          <button class="relative aspect-[2/3] bg-zinc-950 overflow-hidden cursor-pointer text-left" onclick="openInfo(${movie.id})" aria-label="Scheda: ${title}">
            <img src="${escapeHTML(poster)}" alt="${title}" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" loading="lazy">
            ${rating != null ? `<span class="absolute top-2 left-2 px-1.5 py-0.5 rounded bg-yellow-400 text-black font-extrabold font-mono text-xs shadow">${Number(rating).toFixed(1)}</span>` : ''}
            ${tmdbBadge}${awardBadge}${matchBadge}
            ${isWatchlisted ? '<span class="absolute top-2 right-2 px-1.5 py-0.5 rounded bg-blue-600 text-white font-semibold text-[10px]">WL</span>' : ''}
          </button>
          <div class="p-2.5 flex-1 flex flex-col justify-between">
            <div><h4 class="font-semibold text-xs text-white truncate" title="${title}">${title}</h4><p class="text-[10px] text-zinc-500 mt-0.5 truncate" title="${genreLabel}">${year}${genreLabel ? ` \u00b7 ${genreLabel}` : ''}</p></div>
            <div class="mt-2 flex items-center justify-between border-t border-zinc-800/60 pt-2">
              <button onclick="openDrawer(${movie.id})" class="text-[11px] text-yellow-400 font-medium hover:underline">${rating != null ? 'Modifica' : '★ Vota'}</button>
              <button data-library-action onclick="toggleWatchlist(${movie.id})" ${libraryLocked() ? 'disabled' : ''} class="text-[11px] ${isWatchlisted ? 'text-blue-400' : 'text-zinc-500 hover:text-white'}">${isWatchlisted ? 'In Lista' : '+ Watchlist'}</button>
            </div>
          </div>`;
        card.querySelector('img').addEventListener('error', (event) => {
          if (event.target.src !== EMPTY_POSTER) event.target.src = EMPTY_POSTER;
        }, { once: true });
        grid.appendChild(card);
      });
    }

    function findMovie(movieId) {
      return visibleMovies().find((movie) => movie.id === movieId)
        || currentMovies.find((movie) => movie.id === movieId)
        || library.movies.find((movie) => movie.id === movieId);
    }

    function openDrawer(movieId) {
      selectedMovie = findMovie(movieId);
      if (!selectedMovie) return;
      previousFocus = document.activeElement;
      document.getElementById('drawer-title').textContent = selectedMovie.title;
      document.getElementById('drawer-overview').textContent = selectedMovie.overview || 'Nessuna sinossi disponibile.';
      const saved = library.movies.find((movie) => movie.id === movieId) || selectedMovie;
      const personal = library.ratings[movieId] || {};
      const preferences = { loved: 'Amato', liked: 'Piaciuto', disliked: 'Non piaciuto' };
      const meta = [
        movieYear(saved) !== 'N/D' ? movieYear(saved) : '',
        saved.director ? `regia di ${saved.director}` : '',
        saved.runtime_minutes ? `${saved.runtime_minutes} min` : '',
        saved.genres || '',
        personal.watched_at ? `visto il ${new Date(`${personal.watched_at}T00:00:00`).toLocaleDateString('it-IT')}` : '',
        preferences[personal.preference] || '',
      ].filter(Boolean).join(' · ');
      const metaElement = document.getElementById('drawer-meta');
      metaElement.textContent = meta;
      metaElement.hidden = !meta;
      const poster = document.getElementById('drawer-poster');
      poster.src = posterURL(selectedMovie.poster_path);
      poster.alt = `Locandina: ${selectedMovie.title}`;
      const existing = library.ratings[movieId] || { score: 7.5, notes: '' };
      document.getElementById('rating-slider').value = existing.score;
      updateSliderDisplay(existing.score);
      document.getElementById('drawer-notes').value = existing.notes || '';
      document.getElementById('drawer-status').textContent = currentUser ? '' : 'Accedi per votare o aggiungere alla watchlist.';
      document.getElementById('btn-save-rating').textContent = currentUser ? 'Salva Voto' : 'Accedi per votare';
      updateDrawerWatchlistBtn();
      const drawer = document.getElementById('rating-drawer');
      drawer.inert = false;
      drawer.setAttribute('aria-hidden', 'false');
      drawer.classList.remove('translate-x-full');
      document.querySelector('main').inert = true;
      document.querySelector('header').inert = true;
      document.getElementById('drawer-close').focus();
    }

    let infoRequest = 0;
    let infoTrailerKey = '';

    function playTrailer() {
      if (!/^[\w-]{6,20}$/.test(infoTrailerKey)) return;
      const box = document.getElementById('info-trailer');
      box.hidden = false;
      box.innerHTML = `<iframe class="w-full h-full" src="https://www.youtube-nocookie.com/embed/${infoTrailerKey}?autoplay=1&rel=0" title="Trailer" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>`;
      box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    async function openInfo(movieId) {
      const base = findMovie(movieId);
      if (!base) return;
      const modal = document.getElementById('info-modal');
      const body = document.getElementById('info-body');
      const requestId = ++infoRequest;
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      body.innerHTML = `<div class="py-16 text-center text-xs text-zinc-500">Caricamento scheda...</div>`;
      let d = {};
      try { d = await apiFetch(`/movie/${movieId}`); } catch (error) { d = { _error: error.message }; }
      if (requestId !== infoRequest || modal.hidden) return;
      const saved = library.movies.find((movie) => movie.id === movieId) || {};
      const credits = d.credits || {};
      const director = (credits.crew || []).filter((p) => p.job === 'Director').map((p) => p.name).join(', ') || saved.director || '';
      const cast = (credits.cast || []).slice(0, 8).map((p) => p.name).join(', ');
      const countries = (d.production_countries || []).map((c) => c.name).join(', ') || saved.country || '';
      const date = d.release_date ? new Date(`${d.release_date}T00:00:00`).toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' }) : (base.release_date ? new Date(`${base.release_date}T00:00:00`).toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' }) : '');
      const videos = (d.videos?.results || []).filter((v) => v.site === 'YouTube' && /^[\w-]{6,20}$/.test(v.key || ''));
      const origLang = d.original_language || 'en';
      let pool = videos;
      if (!videos.some((v) => v.iso_639_1 === origLang) && origLang !== 'en') {
        try {
          const extra = await apiFetch(`/movie/${movieId}/videos?include_video_language=${origLang}`);
          pool = videos.concat((extra.results || []).filter((v) => v.site === 'YouTube' && /^[\w-]{6,20}$/.test(v.key || '')));
        } catch { /* si usa quello disponibile */ }
      }
      const isTrailer = (v) => v.type === 'Trailer';
      const trailer = pool.find((v) => isTrailer(v) && v.iso_639_1 === origLang) || pool.find((v) => isTrailer(v) && v.iso_639_1 === 'en') || pool.find(isTrailer) || pool.find((v) => v.iso_639_1 === origLang) || pool[0];
      infoTrailerKey = trailer ? trailer.key : '';
      const score = Number(d.vote_average || 0);
      const rows = [['Regia', director], ['Cast', cast], ['Uscita', date], ['Paese', countries], ['Durata', d.runtime ? `${d.runtime} min` : ''], ['Generi', (d.genres || []).map((g) => g.name).join(', ')]]
        .filter(([, v]) => v).map(([k, v]) => `<div class="flex gap-3 text-sm"><dt class="w-16 shrink-0 text-zinc-400">${k}</dt><dd class="text-zinc-100">${escapeHTML(v)}</dd></div>`).join('');
      const inWl = library.watchlist.includes(movieId);
      const rated = library.ratings[movieId]?.score;
      body.innerHTML = `<div id="info-trailer" hidden class="mx-auto mb-5 aspect-video overflow-hidden rounded-lg border border-zinc-800 bg-black" style="width:min(100%,calc(40vh*1.7778))"></div>
        <div class="flex flex-col sm:flex-row gap-5">
        <img src="${escapeHTML(posterURL(base.poster_path))}" alt="Locandina: ${escapeHTML(base.title)}" class="w-40 sm:w-52 self-center sm:self-start rounded-lg border border-zinc-800">
        <div class="min-w-0 flex-1 space-y-4">
          <div><h2 id="info-title" class="text-xl font-bold text-white">${escapeHTML(d.title || base.title)}</h2>
          ${d.original_title && d.original_title !== (d.title || base.title) ? `<p class="text-xs text-zinc-400">${escapeHTML(d.original_title)}</p>` : ''}
          <p class="mt-1 text-xs text-zinc-300">${score > 0 && d.vote_count ? `★ ${score.toFixed(1)} TMDB (${d.vote_count} voti)` : 'Nessun rating TMDB'}${rated != null ? ` · Il tuo voto ${Number(rated).toFixed(1)}` : ''}</p></div>
          ${base.award_lines ? `<ul class="space-y-1 text-xs text-yellow-300">${base.award_lines.map((line) => `<li>${escapeHTML(line)}</li>`).join('')}</ul>` : ''}
          ${base.reason ? `<p class="text-xs text-emerald-300">Per te ${base.match}: ${escapeHTML(base.reason)}</p>` : ''}
          ${d.tagline ? `<p class="text-sm italic text-zinc-300">${escapeHTML(d.tagline)}</p>` : ''}
          <p class="text-sm leading-relaxed text-zinc-100">${escapeHTML(d.overview || base.overview || 'Nessuna sinossi disponibile.')}</p>
          ${d._error ? `<p class="text-xs text-amber-400">Dettagli non disponibili: ${escapeHTML(d._error)}</p>` : ''}
          <dl class="space-y-2">${rows}</dl>
          <div class="flex flex-wrap gap-2 pt-1">
            ${trailer ? `<button onclick="playTrailer()" class="px-4 py-2 rounded-lg bg-red-600 text-white text-xs font-semibold hover:bg-red-500">▶ Guarda il trailer</button><a href="https://www.youtube.com/watch?v=${trailer.key}" target="_blank" rel="noopener noreferrer" class="px-3 py-2 text-xs text-zinc-400 hover:text-white">Apri su YouTube</a>` : '<span class="px-4 py-2 text-xs text-zinc-400">Trailer non disponibile</span>'}
            <button onclick="closeInfo();openDrawer(${movieId})" class="px-4 py-2 rounded-lg bg-yellow-400 text-black text-xs font-semibold hover:bg-yellow-300">${rated != null ? 'Modifica voto' : '★ Vota'}</button>
            <button id="info-wl" onclick="infoWatchlist(${movieId})" class="px-4 py-2 rounded-lg border border-zinc-600 text-zinc-200 text-xs hover:border-yellow-400">${inWl ? 'Rimuovi da Watchlist' : '+ Watchlist'}</button>
          </div>
        </div></div>`;
    }

    async function infoWatchlist(movieId) {
      await toggleWatchlist(movieId);
      const button = document.getElementById('info-wl');
      if (button) button.textContent = library.watchlist.includes(movieId) ? 'Rimuovi da Watchlist' : '+ Watchlist';
    }

    function closeInfo() {
      infoRequest++;
      infoTrailerKey = '';
      document.getElementById('info-body').innerHTML = '';
      document.getElementById('info-modal').hidden = true;
      document.body.style.overflow = '';
    }

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !document.getElementById('info-modal').hidden) closeInfo();
    });

    function closeDrawer() {
      const drawer = document.getElementById('rating-drawer');
      drawer.classList.add('translate-x-full');
      drawer.setAttribute('aria-hidden', 'true');
      drawer.inert = true;
      document.querySelector('main').inert = false;
      document.querySelector('header').inert = false;
      if (previousFocus?.isConnected) previousFocus.focus();
      else document.getElementById(`tab-${activeTab}`).focus();
    }

    function updateSliderDisplay(value) {
      document.getElementById('rating-display').textContent = Number(value).toFixed(1);
    }

    function adjustRating(delta) {
      const slider = document.getElementById('rating-slider');
      const value = Math.min(10, Math.max(1, parseFloat(slider.value) + delta));
      slider.value = value.toFixed(1);
      updateSliderDisplay(value);
    }

    function libraryLocked() {
      return saving || Boolean(currentUser && !libraryReady);
    }

    function updateSaveControls() {
      document.querySelectorAll('[data-library-action], #btn-save-rating, #btn-watchlist-drawer').forEach((button) => {
        button.disabled = libraryLocked();
      });
    }

    function requireLogin() {
      if (currentUser) return true;
      const drawer = document.getElementById('rating-drawer');
      if (!drawer.inert) closeDrawer();
      openAuth('login', 'Accedi per salvare film nella watchlist e votarli.');
      return false;
    }

    async function saveLibrary(change) {
      if (!requireLogin() || !libraryReady || saving) return false;
      saving = true;
      updateSaveControls();
      document.getElementById('drawer-status').textContent = 'Salvataggio...';
      document.getElementById('library-status').textContent = 'Salvataggio...';
      try {
        library = await fetchJSON('/api/library', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(change),
        });
        renderActiveMovies();
        updateDrawerWatchlistBtn();
        document.getElementById('library-status').textContent = '';
        document.getElementById('drawer-status').textContent = 'Salvato.';
        if (activeTab !== 'discover') setStatus(activeTab === 'watchlist'
          ? `Watchlist: ${library.watchlist.length} film salvati.` : `Film votati: ${Object.keys(library.ratings).length}.`);
        return true;
      } catch (error) {
        const message = error.message || 'Errore di salvataggio. Nessuna modifica salvata.';
        document.getElementById('library-status').textContent = message;
        document.getElementById('drawer-status').textContent = message;
        return false;
      } finally {
        saving = false;
        updateSaveControls();
      }
    }

    async function saveRating() {
      if (!selectedMovie || !requireLogin()) return;
      const saved = await saveLibrary({
        action: 'rate',
        movie: selectedMovie,
        score: parseFloat(document.getElementById('rating-slider').value),
        notes: document.getElementById('drawer-notes').value.trim(),
      });
      if (saved) closeDrawer();
    }

    async function toggleWatchlist(movieId) {
      if (!requireLogin()) return;
      const movie = findMovie(movieId);
      if (!movie) return;
      await saveLibrary({ action: 'watchlist', movie, watchlisted: !library.watchlist.includes(movieId) });
    }

    function toggleWatchlistCurrent() {
      if (selectedMovie) return toggleWatchlist(selectedMovie.id);
    }

    function updateDrawerWatchlistBtn() {
      if (!selectedMovie) return;
      const button = document.getElementById('btn-watchlist-drawer');
      const inWatchlist = library.watchlist.includes(selectedMovie.id);
      button.textContent = inWatchlist ? 'Rimuovi da Watchlist' : '+ Watchlist';
      button.className = inWatchlist
        ? 'px-4 py-2.5 bg-blue-900/40 border border-blue-700 text-xs text-blue-200 rounded-lg'
        : 'px-4 py-2.5 bg-zinc-900 border border-zinc-700 text-xs text-zinc-200 rounded-lg hover:bg-zinc-800';
      updateSaveControls();
    }

    function updateTabs() {
      ['discover', 'awards', 'watchlist', 'rated', 'import'].forEach((tab) => {
        const button = document.getElementById(`tab-${tab}`);
        button.className = tab === activeTab
          ? 'px-3 py-1.5 text-xs font-medium rounded-md bg-yellow-400/10 text-yellow-400'
          : 'px-3 py-1.5 text-xs font-medium rounded-md text-zinc-400 hover:text-white';
        if (tab === activeTab) button.setAttribute('aria-current', 'page');
        else button.removeAttribute('aria-current');
      });
      document.getElementById('search-section').style.display = activeTab === 'discover' ? 'block' : 'none';
      document.getElementById('movie-grid').hidden = activeTab === 'import';
      document.getElementById('import-section').hidden = activeTab !== 'import';
    }

    function switchTab(tab) {
      if (tab === 'import' && !currentUser) return openAuth('login', "Accedi per importare i tuoi film.");
      activeTab = tab;
      ++searchRequest;
      document.getElementById('movie-grid').removeAttribute('aria-busy');
      updateTabs();
      updateFilterBars();
      if (tab === 'discover') return loadFeed(feedFilter);
      if (tab === 'awards') return loadAwards(awardsFilter);
      if (tab === 'import') {
        setStatus('');
        return renderImport();
      }
      renderActiveMovies();
      if (!currentUser) return setStatus('');
      setStatus(tab === 'watchlist' ? `Watchlist: ${library.watchlist.length} film salvati.` : `Rated: ${Object.keys(library.ratings).length} film.`);
    }

    function updateCounters() {
      document.getElementById('count-watchlist').textContent = library.watchlist.length;
      document.getElementById('count-rated').textContent = Object.keys(library.ratings).length;
    }

    async function loadLibrary() {
      if (!currentUser) return;
      document.getElementById('library-status').textContent = 'Caricamento watchlist e voti...';
      updateSaveControls();
      try {
        const data = await fetchJSON('/api/library');
        if (!currentUser) return;
        library = data;
        libraryReady = true;
        document.getElementById('library-status').textContent = '';
        updateCounters();
        if (!document.getElementById('movie-grid').hasAttribute('aria-busy')) renderActiveMovies();
      } catch (error) {
        document.getElementById('library-status').textContent = `${error.message} Ricarica la pagina per riprovare. I tuoi dati non sono stati modificati.`;
      } finally {
        updateSaveControls();
      }
    }

    document.getElementById('drawer-poster').addEventListener('error', (event) => {
      if (event.target.src !== EMPTY_POSTER) event.target.src = EMPTY_POSTER;
    });

    document.addEventListener('keydown', (event) => {
      const modal = document.getElementById('auth-modal');
      if (!modal.inert) {
        if (event.key === 'Escape') closeAuth();
        if (event.key === 'Tab') trapFocus(event, modal);
        return;
      }
      const drawer = document.getElementById('rating-drawer');
      if (drawer.inert) return;
      if (event.key === 'Escape') closeDrawer();
      if (event.key === 'Tab') trapFocus(event, drawer);
    });

    function trapFocus(event, container) {
      const controls = Array.from(container.querySelectorAll('button:not(:disabled), input:not([hidden]), textarea, select'))
        .filter((control) => control.offsetParent !== null);
      const first = controls[0];
      const last = controls[controls.length - 1];
      if (!first) return;
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
    }

    const AUTH_MODES = {
      login: { title: 'Accedi', subtitle: 'Accedi per salvare watchlist, voti e note.', submit: 'Accedi', email: true, password: 'Password', autocomplete: 'current-password' },
      signup: { title: 'Registrati', subtitle: 'Crea un account gratuito con email e password.', submit: 'Crea account', email: true, password: 'Password (almeno 8 caratteri)', autocomplete: 'new-password' },
      forgot: { title: 'Password dimenticata?', subtitle: 'Inserisci la tua email: ti invieremo un link per scegliere una nuova password.', submit: 'Invia link', email: true, password: null },
      reset: { title: 'Nuova password', subtitle: 'Scegli una nuova password per il tuo account.', submit: 'Salva password', email: false, password: 'Nuova password (almeno 8 caratteri)', autocomplete: 'new-password' },
      invite: { title: 'Completa la registrazione', subtitle: 'Scegli una password per attivare il tuo account.', submit: 'Attiva account', email: false, password: 'Password (almeno 8 caratteri)', autocomplete: 'new-password' },
    };
    const AUTH_LINKS = {
      login: [['forgot', 'Password dimenticata?'], ['signup', 'Non hai un account? Registrati']],
      signup: [['login', 'Hai già un account? Accedi']],
      forgot: [['login', "Torna all'accesso"]],
      reset: [],
      invite: [],
    };
    let authMode = 'login';
    let authBusy = false;
    let inviteToken = null;
    let authPreviousFocus = null;

    function openAuth(mode = 'login', message = '', tone = 'info') {
      const config = AUTH_MODES[mode];
      authMode = mode;
      document.getElementById('auth-title').textContent = config.title;
      document.getElementById('auth-subtitle').textContent = config.subtitle;
      document.getElementById('auth-submit').textContent = config.submit;
      document.getElementById('auth-field-email').hidden = !config.email;
      document.getElementById('auth-field-password').hidden = !config.password;
      const password = document.getElementById('auth-password');
      password.value = '';
      if (config.password) {
        document.getElementById('auth-password-label').textContent = config.password;
        password.autocomplete = config.autocomplete;
      }
      document.getElementById('auth-links').innerHTML = AUTH_LINKS[mode].map(([target, label]) =>
        `<button type="button" onclick="openAuth('${target}')" class="text-left text-yellow-400 hover:underline">${escapeHTML(label)}</button>`).join('');
      setAuthMessage(message, tone);
      const modal = document.getElementById('auth-modal');
      if (modal.inert) authPreviousFocus = document.activeElement;
      modal.hidden = false;
      modal.inert = false;
      modal.setAttribute('aria-hidden', 'false');
      document.querySelector('main').inert = true;
      document.querySelector('header').inert = true;
      (config.email ? document.getElementById('auth-email') : password).focus();
    }

    function closeAuth() {
      const modal = document.getElementById('auth-modal');
      modal.hidden = true;
      modal.inert = true;
      modal.setAttribute('aria-hidden', 'true');
      document.querySelector('main').inert = false;
      document.querySelector('header').inert = false;
      if (authPreviousFocus?.isConnected) authPreviousFocus.focus();
    }

    function setAuthMessage(text, tone = 'info') {
      const element = document.getElementById('auth-message');
      element.textContent = text;
      element.className = `text-xs min-h-[1rem] ${tone === 'error' ? 'text-red-400' : tone === 'success' ? 'text-green-400' : 'text-zinc-400'}`;
    }

    function authErrorMessage(error) {
      if (Auth && error instanceof Auth.MissingIdentityError) return 'Il sistema di accesso non è attivo su questo sito. Riprova più tardi.';
      const text = String(error?.message || '').toLowerCase();
      const status = error?.status;
      if (text.includes('not confirmed')) return "Devi prima confermare l'email: controlla la tua casella di posta e apri il link che ti abbiamo inviato.";
      if (text.includes('already') || text.includes('registered')) return 'Esiste già un account con questa email. Prova ad accedere.';
      if (status === 403 || text.includes('signups not allowed')) return 'Le registrazioni non sono attive in questo momento.';
      if (status === 429 || text.includes('rate limit') || text.includes('too many')) return 'Troppi tentativi. Attendi qualche minuto e riprova.';
      if (text.includes('password') && (text.includes('short') || text.includes('weak') || text.includes('characters'))) return 'La password è troppo debole: usa almeno 8 caratteri.';
      if (authMode === 'login' && (status === 400 || status === 401 || text.includes('invalid') || text.includes('no user'))) return 'Email o password non corretti.';
      if (text.includes('token') || text.includes('expired')) return 'Il link non è valido o è scaduto. Richiedine uno nuovo.';
      if (text.includes('fetch') || text.includes('network')) return 'Impossibile contattare il servizio di accesso. Controlla la connessione e riprova.';
      return 'Operazione non riuscita. Riprova.';
    }

    async function submitAuth() {
      if (authBusy || !Auth) return;
      const config = AUTH_MODES[authMode];
      const email = document.getElementById('auth-email').value.trim();
      const password = document.getElementById('auth-password').value;
      if (config.email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return setAuthMessage('Inserisci un indirizzo email valido.', 'error');
      if (authMode === 'login' && !password) return setAuthMessage('Inserisci la password.', 'error');
      if (config.password && authMode !== 'login' && password.length < 8) return setAuthMessage('La password deve contenere almeno 8 caratteri.', 'error');
      authBusy = true;
      const submit = document.getElementById('auth-submit');
      submit.disabled = true;
      setAuthMessage('Attendi...');
      try {
        if (authMode === 'login') {
          setCurrentUser(await Auth.login(email, password));
          closeAuth();
          showNotice(`Bentornato, ${currentUser?.email || ''}.`);
        } else if (authMode === 'signup') {
          const user = await Auth.signup(email, password);
          if (user?.confirmedAt) {
            setCurrentUser(user);
            closeAuth();
            showNotice('Account creato. Hai effettuato l\'accesso.');
          } else {
            openAuth('login', `Controlla la tua email per confermare l'account: abbiamo inviato un link a ${email}.`, 'success');
            document.getElementById('auth-email').value = email;
          }
        } else if (authMode === 'forgot') {
          await Auth.requestPasswordRecovery(email);
          setAuthMessage('Se l\'email è registrata, riceverai a breve un link per reimpostare la password.', 'success');
        } else if (authMode === 'reset') {
          setCurrentUser(await Auth.updateUser({ password }));
          closeAuth();
          showNotice('Password aggiornata. Hai effettuato l\'accesso.');
        } else if (authMode === 'invite') {
          setCurrentUser(await Auth.acceptInvite(inviteToken, password));
          inviteToken = null;
          closeAuth();
          showNotice('Account attivato. Benvenuto!');
        }
      } catch (error) {
        setAuthMessage(authErrorMessage(error), 'error');
      } finally {
        authBusy = false;
        submit.disabled = false;
      }
    }

    function showNotice(text) {
      document.getElementById('library-status').textContent = text;
    }

    function renderAccount() {
      const loggedIn = Boolean(currentUser);
      document.getElementById('btn-open-login').hidden = loggedIn;
      document.getElementById('btn-logout').hidden = !loggedIn;
      document.getElementById('tab-import').hidden = !loggedIn;
      const email = document.getElementById('account-email');
      email.hidden = !loggedIn;
      email.textContent = currentUser?.email || '';
      email.title = currentUser?.email || '';
    }

    function setCurrentUser(user) {
      const previousId = currentUser?.id ?? null;
      currentUser = user?.id ? user : null;
      renderAccount();
      if ((currentUser?.id ?? null) === previousId) return;
      library = { watchlist: [], ratings: {}, movies: [] };
      libraryReady = false;
      resetImport();
      updateCounters();
      if (activeTab === 'import' && !currentUser) switchTab('discover');
      else if (!document.getElementById('movie-grid').hasAttribute('aria-busy')) renderActiveMovies();
      updateSaveControls();
      loadLibrary();
    }

    async function handleLogout() {
      try {
        await Auth.logout();
      } catch {
        // La sessione locale viene comunque chiusa.
      }
      setCurrentUser(null);
      showNotice('Sei uscito dal tuo account.');
    }

    async function initAuth() {
      if (!Auth) {
        showNotice('Il sistema di accesso non è disponibile. Ricarica la pagina.');
        return;
      }
      Auth.onAuthChange((event, user) => {
        if (event === 'logout') setCurrentUser(null);
        else if (user) setCurrentUser(user);
      });
      const hadCallback = /(confirmation|recovery|invite|email_change)_token=|access_token=|error=/.test(window.location.hash);
      let callback = null;
      try {
        callback = await Auth.handleAuthCallback();
      } catch (error) {
        if (hadCallback) openAuth('login', 'Il link non è valido o è scaduto. Accedi o richiedi un nuovo link.', 'error');
      }
      if (hadCallback) history.replaceState(null, '', window.location.pathname + window.location.search);
      setCurrentUser(callback?.user || await Auth.getUser());
      if (callback?.type === 'confirmation') showNotice("Email confermata. Hai effettuato l'accesso.");
      if (callback?.type === 'email_change') showNotice('Indirizzo email aggiornato.');
      if (callback?.type === 'recovery') openAuth('reset');
      if (callback?.type === 'invite' && callback.token) {
        inviteToken = callback.token;
        openAuth('invite');
      }
    }

    const IMPORT_FIELDS = [
      { key: 'title', label: 'Titolo', hint: 'obbligatoria', guesses: ['titolo', 'title', 'nome', 'name', 'film', 'titolo originale', 'original title'] },
      { key: 'year', label: 'Anno', hint: 'facoltativa', guesses: ['anno', 'year', 'anno di uscita', 'release year', 'data di uscita', 'release date'] },
      { key: 'score', label: 'Voto', hint: 'facoltativa, da 1 a 10', guesses: ['voto', 'rating', 'your rating', 'score', 'punteggio', 'valutazione'] },
      { key: 'notes', label: 'Note', hint: 'facoltativa', guesses: ['note', 'notes', 'commento', 'commenti', 'recensione', 'review'] },
      { key: 'wishlist', label: 'Wishlist', hint: 'facoltativa: sì, si, x, 1, true', guesses: ['wishlist', 'watchlist', 'da vedere', 'lista desideri', 'wish'] },
    ];
    const IMPORT_STEPS = [['upload', 'Carica'], ['map', 'Colonne'], ['review', 'Anteprima'], ['done', 'Fatto']];
    const IMPORT_MAX_ROWS = 5000;
    const IMPORT_BATCH = 50;
    const TMDB_THUMB_URL = 'https://image.tmdb.org/t/p/w92';
    let importState = freshImportState();
    let importRun = 0;

    function freshImportState() {
      return { step: 'upload', fileName: '', headers: [], rows: [], mapping: {}, entries: [], ignored: 0, ignoredReasons: [],
        progress: 0, message: '', messageTone: 'error', result: null, saving: false };
    }

    function resetImport() {
      ++importRun;
      importState = freshImportState();
      if (activeTab === 'import') renderImport();
    }

    function setImportMessage(text, tone = 'error') {
      importState.message = text;
      importState.messageTone = tone;
    }

    function normalizeText(value) {
      return String(value ?? '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
    }

    function detectDelimiter(text) {
      const firstLine = text.split(/\r?\n/, 1)[0] || '';
      let quoted = false;
      const counts = { ';': 0, ',': 0, '\t': 0 };
      for (const character of firstLine) {
        if (character === '"') quoted = !quoted;
        else if (!quoted && character in counts) counts[character]++;
      }
      const [best, count] = Object.entries(counts).sort((a, b) => b[1] - a[1])[0];
      return count > 0 ? best : ',';
    }

    function parseCSV(text, delimiter) {
      const rows = [];
      let row = [];
      let field = '';
      let quoted = false;
      for (let index = 0; index < text.length; index++) {
        const character = text[index];
        if (quoted) {
          if (character === '"' && text[index + 1] === '"') { field += '"'; index++; }
          else if (character === '"') quoted = false;
          else field += character;
        } else if (character === '"' && field.trim() === '') {
          quoted = true;
          field = '';
        } else if (character === delimiter) {
          row.push(field);
          field = '';
        } else if (character === '\n' || character === '\r') {
          if (character === '\r' && text[index + 1] === '\n') index++;
          row.push(field);
          rows.push(row);
          row = [];
          field = '';
        } else {
          field += character;
        }
      }
      if (field !== '' || row.length) {
        row.push(field);
        rows.push(row);
      }
      return rows.filter((cells) => cells.some((cell) => cell.trim() !== ''));
    }

    async function readCSVFile(file) {
      const buffer = await file.arrayBuffer();
      let text = new TextDecoder('utf-8').decode(buffer);
      // I file esportati da Excel su Windows spesso non sono in UTF-8.
      if (text.includes('�')) text = new TextDecoder('windows-1252').decode(buffer);
      return text.replace(/^﻿/, '');
    }

    function guessMapping(headers) {
      const normalized = headers.map(normalizeText);
      const mapping = {};
      const used = new Set();
      for (const exact of [true, false]) {
        IMPORT_FIELDS.forEach((field) => {
          if (mapping[field.key] !== undefined) return;
          const index = normalized.findIndex((header, position) => !used.has(position) && header
            && field.guesses.some((guess) => exact ? header === guess : header.includes(guess)));
          if (index >= 0) {
            mapping[field.key] = index;
            used.add(index);
          }
        });
      }
      return mapping;
    }

    async function handleImportFile(input) {
      const file = input.files?.[0];
      if (!file) return;
      ++importRun;
      importState = freshImportState();
      if (file.size > 5 * 1024 * 1024) {
        setImportMessage('Il file è troppo grande: il limite è 5 MB.');
        return renderImport();
      }
      try {
        const text = await readCSVFile(file);
        const rows = parseCSV(text, detectDelimiter(text));
        if (rows.length < 2) {
          setImportMessage('Il file deve contenere una riga di intestazione e almeno un film.');
          return renderImport();
        }
        if (rows.length - 1 > IMPORT_MAX_ROWS) {
          setImportMessage(`Il file contiene troppe righe: il limite è ${IMPORT_MAX_ROWS} film per importazione. Dividilo in più file.`);
          return renderImport();
        }
        importState.fileName = file.name;
        importState.headers = rows[0].map((header, index) => header.trim() || `Colonna ${index + 1}`);
        importState.rows = rows.slice(1);
        importState.mapping = guessMapping(importState.headers);
        importState.step = 'map';
      } catch {
        setImportMessage('Impossibile leggere il file. Assicurati che sia un CSV.');
      }
      renderImport();
    }

    function parseScore(value) {
      const text = String(value ?? '').trim().replace(',', '.');
      if (!text) return { score: null, invalid: false };
      const score = Number(text);
      if (!Number.isFinite(score) || score < 1 || score > 10) return { score: null, invalid: true };
      return { score: Math.round(score * 10) / 10, invalid: false };
    }

    function parseYear(value) {
      return String(value ?? '').match(/\b(18|19|20)\d{2}\b/)?.[0] || '';
    }

    function parseWishlist(value) {
      return ['sì', 'si', 'x', '1', 'true', 'yes', 'vero'].includes(String(value ?? '').trim().toLowerCase());
    }

    function readMappingFromForm() {
      const mapping = {};
      IMPORT_FIELDS.forEach((field) => {
        const value = document.getElementById(`map-${field.key}`).value;
        if (value !== '') mapping[field.key] = Number(value);
      });
      return mapping;
    }

    function buildEntries(mapping) {
      const cell = (row, key) => mapping[key] === undefined ? '' : String(row[mapping[key]] ?? '').trim();
      const entries = [];
      const reasons = { noTitle: 0, noData: 0, badScore: 0 };
      importState.rows.forEach((row, index) => {
        const title = cell(row, 'title').slice(0, 200);
        if (!title) return reasons.noTitle++;
        const { score, invalid } = parseScore(cell(row, 'score'));
        const wishlist = parseWishlist(cell(row, 'wishlist'));
        if (score === null && !wishlist) return invalid ? reasons.badScore++ : reasons.noData++;
        entries.push({ id: entries.length, row: index + 2, title, query: title, year: parseYear(cell(row, 'year')),
          score, wishlist, notes: cell(row, 'notes').slice(0, 5000), status: 'pending', movie: null, candidates: [], previousStatus: null, busy: false });
      });
      const ignoredReasons = [];
      if (reasons.noTitle) ignoredReasons.push(`${reasons.noTitle} senza titolo`);
      if (reasons.noData) ignoredReasons.push(`${reasons.noData} senza voto né wishlist`);
      if (reasons.badScore) ignoredReasons.push(`${reasons.badScore} con un voto non valido (deve essere tra 1 e 10)`);
      return { entries, ignored: reasons.noTitle + reasons.noData + reasons.badScore, ignoredReasons };
    }

    const delay = (milliseconds) => new Promise((resolve) => setTimeout(resolve, milliseconds));

    async function searchTMDB(title, year) {
      const base = `/search/movie?query=${encodeURIComponent(title)}`;
      for (let attempt = 0; attempt < 3; attempt++) {
        try {
          let results = [];
          if (year) results = (await apiFetch(`${base}&year=${year}`)).results || [];
          if (!results.length) results = (await apiFetch(base)).results || [];
          return results;
        } catch (error) {
          if (attempt === 2) throw error;
          await delay(1500 * (attempt + 1));
        }
      }
    }

    function classifyEntry(entry, results) {
      const yearOf = (movie) => (movie.release_date || '').slice(0, 4);
      const valid = results.filter((movie) => Number.isSafeInteger(movie.id) && movie.id > 0 && typeof movie.title === 'string' && movie.title.trim());
      const wanted = normalizeText(entry.query);
      const exact = valid.filter((movie) => normalizeText(movie.title) === wanted || normalizeText(movie.original_title) === wanted);
      const exactYear = entry.year ? exact.filter((movie) => yearOf(movie) === entry.year) : exact;
      const preferred = [...exactYear, ...exact, ...valid].filter((movie, index, list) => list.findIndex((other) => other.id === movie.id) === index);
      entry.candidates = preferred.slice(0, 6);
      entry.movie = null;
      if (!valid.length) entry.status = 'missing';
      else if (exactYear.length === 1 || valid.length === 1) {
        entry.status = 'found';
        entry.movie = exactYear.length === 1 ? exactYear[0] : valid[0];
      } else entry.status = 'doubt';
    }

    async function resolveEntry(entry) {
      try {
        classifyEntry(entry, await searchTMDB(entry.query, entry.year));
        entry.error = '';
      } catch (error) {
        entry.status = 'missing';
        entry.candidates = [];
        entry.error = error.message || 'Ricerca non riuscita.';
      }
    }

    async function startImportSearch() {
      const mapping = readMappingFromForm();
      importState.mapping = mapping;
      if (mapping.title === undefined) {
        setImportMessage('Scegli la colonna che contiene il titolo.');
        return renderImport();
      }
      if (mapping.score === undefined && mapping.wishlist === undefined) {
        setImportMessage('Scegli almeno la colonna del voto o quella della wishlist, altrimenti non c\'è niente da importare.');
        return renderImport();
      }
      const { entries, ignored, ignoredReasons } = buildEntries(mapping);
      if (!entries.length) {
        setImportMessage(`Nessuna riga da importare${ignoredReasons.length ? `: ${ignoredReasons.join(', ')}` : ''}.`);
        return renderImport();
      }
      Object.assign(importState, { entries, ignored, ignoredReasons, step: 'search', progress: 0, message: '' });
      renderImport();
      const run = ++importRun;
      let next = 0;
      const worker = async () => {
        while (next < entries.length && run === importRun) {
          const entry = entries[next++];
          await resolveEntry(entry);
          if (run !== importRun) return;
          importState.progress++;
          updateImportProgress();
          // Breve pausa per restare entro i limiti di richieste di TMDB.
          await delay(150);
        }
      };
      await Promise.all([worker(), worker(), worker()]);
      if (run !== importRun) return;
      importState.step = 'review';
      renderImport();
    }

    function updateImportProgress() {
      const total = importState.entries.length;
      const percent = total ? Math.round((importState.progress / total) * 100) : 0;
      const bar = document.getElementById('import-progress-bar');
      const label = document.getElementById('import-progress-label');
      if (bar) bar.style.width = `${percent}%`;
      if (bar) bar.parentElement.setAttribute('aria-valuenow', String(percent));
      if (label) label.textContent = `Ricerca su TMDB: ${importState.progress} di ${total} film (${percent}%)`;
    }

    function findEntry(entryId) {
      return importState.entries.find((entry) => entry.id === entryId);
    }

    function chooseCandidate(entryId, movieId) {
      const entry = findEntry(entryId);
      const movie = entry?.candidates.find((candidate) => candidate.id === movieId);
      if (!movie) return;
      entry.movie = movie;
      entry.status = 'found';
      renderImport();
    }

    function changeMatch(entryId) {
      const entry = findEntry(entryId);
      if (!entry) return;
      entry.status = entry.candidates.length ? 'doubt' : 'missing';
      entry.movie = null;
      renderImport();
    }

    function skipEntry(entryId) {
      const entry = findEntry(entryId);
      if (!entry || entry.status === 'skipped') return;
      entry.previousStatus = entry.status;
      entry.status = 'skipped';
      renderImport();
    }

    function restoreEntry(entryId) {
      const entry = findEntry(entryId);
      if (!entry) return;
      entry.status = entry.previousStatus || (entry.movie ? 'found' : entry.candidates.length ? 'doubt' : 'missing');
      renderImport();
    }

    async function retryEntry(entryId) {
      const entry = findEntry(entryId);
      const input = document.getElementById(`retry-${entryId}`);
      const query = input?.value.trim().slice(0, 200);
      if (!entry || !query || entry.busy) return;
      entry.query = query;
      entry.busy = true;
      renderImport();
      const run = importRun;
      await resolveEntry(entry);
      entry.busy = false;
      if (run !== importRun) return;
      renderImport();
      if (entry.status === 'missing') document.getElementById(`retry-${entryId}`)?.focus();
    }

    function importItems() {
      const byMovie = new Map();
      importState.entries.filter((entry) => entry.status === 'found' && entry.movie).forEach((entry) => {
        const previous = byMovie.get(entry.movie.id);
        if (previous && previous.score !== null && entry.score === null) return;
        const { id, title, poster_path, release_date, overview } = entry.movie;
        byMovie.set(id, {
          movie: { id, title, poster_path: poster_path || null, release_date: release_date || '', overview: overview || '' },
          score: entry.score,
          notes: entry.notes,
          watchlisted: entry.score === null && entry.wishlist,
        });
      });
      return [...byMovie.values()];
    }

    async function confirmImport() {
      if (importState.saving || !requireLogin()) return;
      const items = importItems();
      if (!items.length) {
        setImportMessage('Non ci sono film confermati da importare.');
        return renderImport();
      }
      importState.saving = true;
      setImportMessage(`Salvataggio: 0 di ${items.length} film...`, 'info');
      renderImport();
      const run = importRun;
      const result = { imported: 0, rated: 0, watchlisted: 0 };
      try {
        for (let start = 0; start < items.length; start += IMPORT_BATCH) {
          const saved = await fetchJSON('/api/library/import', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: items.slice(start, start + IMPORT_BATCH) }),
          });
          if (run !== importRun) return;
          result.imported += saved.imported;
          result.rated += saved.rated;
          result.watchlisted += saved.watchlisted;
          setImportMessage(`Salvataggio: ${Math.min(start + IMPORT_BATCH, items.length)} di ${items.length} film...`, 'info');
          renderImport();
        }
        const notImported = importState.entries.filter((entry) => entry.status !== 'found').length;
        importState.result = { ...result, skipped: importState.ignored + notImported,
          merged: importState.entries.filter((entry) => entry.status === 'found').length - items.length };
        importState.step = 'done';
        importState.message = '';
        loadLibrary();
      } catch (error) {
        const savedText = result.imported ? ` ${result.imported} film sono già stati salvati: puoi riprovare senza creare doppioni.` : '';
        setImportMessage(`${error.message || 'Importazione non riuscita.'}${savedText}`);
      } finally {
        importState.saving = false;
        if (run === importRun) renderImport();
      }
    }

    function downloadSampleCSV() {
      const content = '﻿titolo;anno;voto;note;wishlist\n'
        + 'Il Padrino;1972;9,5;Capolavoro assoluto;\n'
        + 'Parasite;2019;8;;\n'
        + 'La grande bellezza;2013;7,5;Fotografia splendida;\n'
        + 'Dune - Parte due;2024;;;sì\n'
        + 'Perfect Days;2023;;Consigliato da un amico;x\n';
      const url = URL.createObjectURL(new Blob([content], { type: 'text/csv;charset=utf-8' }));
      const link = document.createElement('a');
      link.href = url;
      link.download = 'esempio-minimal-ego.csv';
      document.body.appendChild(link);
      link.click();
      link.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    }

    function thumbURL(path) {
      return typeof path === 'string' && /^\/[a-zA-Z0-9_.-]+$/.test(path) ? `${TMDB_THUMB_URL}${path}` : EMPTY_POSTER;
    }

    function movieYear(movie) {
      return movie?.release_date ? movie.release_date.slice(0, 4) : (movie?.year ? String(movie.year) : 'N/D');
    }

    function entrySummary(entry) {
      const parts = [`Riga ${entry.row}: «${escapeHTML(entry.title)}»${entry.year ? ` (${escapeHTML(entry.year)})` : ''}`];
      parts.push(entry.score !== null ? `voto <span class="text-yellow-400 font-mono">${entry.score.toFixed(1)}</span>` : '<span class="text-blue-400">watchlist</span>');
      return parts.join(' · ');
    }

    const importButton = 'px-2.5 py-1 bg-zinc-900 border border-zinc-700 text-[11px] text-zinc-200 rounded-md hover:bg-zinc-800';

    function renderEntryRow(entry) {
      if (entry.status === 'found') {
        return `<li class="flex items-center gap-3 p-2.5 bg-zinc-900 border border-zinc-800 rounded-lg">
          <img src="${escapeHTML(thumbURL(entry.movie.poster_path))}" alt="" class="w-10 h-14 object-cover rounded bg-zinc-800 flex-none" loading="lazy">
          <div class="min-w-0 flex-1">
            <p class="text-xs font-semibold text-white truncate">${escapeHTML(entry.movie.title)} <span class="text-zinc-500 font-normal">(${escapeHTML(movieYear(entry.movie))})</span></p>
            <p class="text-[10px] text-zinc-500 truncate">${entrySummary(entry)}</p>
          </div>
          <div class="flex gap-1.5 flex-none">
            ${entry.candidates.length > 1 ? `<button onclick="changeMatch(${entry.id})" class="${importButton}">Cambia</button>` : ''}
            <button onclick="skipEntry(${entry.id})" class="${importButton}">Salta</button>
          </div>
        </li>`;
      }
      if (entry.status === 'doubt') {
        return `<li class="p-3 bg-zinc-900 border border-amber-500/30 rounded-lg">
          <div class="flex items-start justify-between gap-3 mb-2">
            <p class="text-[11px] text-zinc-300">${entrySummary(entry)}<br><span class="text-zinc-500">Quale di questi film è quello giusto?</span></p>
            <button onclick="skipEntry(${entry.id})" class="${importButton} flex-none">Salta</button>
          </div>
          <div class="grid grid-cols-3 sm:grid-cols-6 gap-2">
            ${entry.candidates.map((movie) => `<button onclick="chooseCandidate(${entry.id}, ${Number(movie.id)})" class="text-left bg-zinc-950 border border-zinc-800 rounded-md overflow-hidden hover:border-yellow-400 transition">
              <img src="${escapeHTML(thumbURL(movie.poster_path))}" alt="" class="w-full aspect-[2/3] object-cover bg-zinc-800" loading="lazy">
              <span class="block p-1.5 text-[10px] text-white leading-tight line-clamp-2">${escapeHTML(movie.title)}</span>
              <span class="block px-1.5 pb-1.5 text-[10px] text-zinc-500">${escapeHTML(movieYear(movie))}</span>
            </button>`).join('')}
          </div>
        </li>`;
      }
      if (entry.status === 'missing') {
        return `<li class="p-3 bg-zinc-900 border border-red-500/30 rounded-lg">
          <p class="text-[11px] text-zinc-300 mb-2">${entrySummary(entry)}${entry.error ? `<br><span class="text-red-400">${escapeHTML(entry.error)}</span>` : ''}</p>
          <div class="flex gap-2">
            <input id="retry-${entry.id}" value="${escapeHTML(entry.query)}" maxlength="200" aria-label="Correggi il titolo di riga ${entry.row}"
              onkeydown="if(event.key === 'Enter') retryEntry(${entry.id})"
              class="min-w-0 flex-1 bg-zinc-950 border border-zinc-800 rounded-md px-2.5 py-1.5 text-xs text-white focus:outline-none focus:border-yellow-400">
            <button onclick="retryEntry(${entry.id})" ${entry.busy ? 'disabled' : ''} class="px-2.5 py-1 bg-yellow-400 text-black font-semibold text-[11px] rounded-md hover:bg-yellow-300">${entry.busy ? 'Ricerca...' : 'Riprova'}</button>
            <button onclick="skipEntry(${entry.id})" class="${importButton}">Salta</button>
          </div>
        </li>`;
      }
      return `<li class="flex items-center justify-between gap-3 p-2.5 bg-zinc-900/50 border border-zinc-800 rounded-lg">
        <p class="text-[10px] text-zinc-500 truncate">${entrySummary(entry)}</p>
        <button onclick="restoreEntry(${entry.id})" class="${importButton} flex-none">Ripristina</button>
      </li>`;
    }

    function renderImportGroup(title, description, entries, tone, open = true) {
      if (!entries.length) return '';
      return `<details ${open ? 'open' : ''} class="mb-5">
        <summary class="cursor-pointer text-sm font-semibold ${tone} mb-1">${title} (${entries.length})</summary>
        <p class="text-[11px] text-zinc-500 mb-3">${description}</p>
        <ul class="space-y-2">${entries.map(renderEntryRow).join('')}</ul>
      </details>`;
    }

    function renderImport() {
      const container = document.getElementById('import-content');
      if (!container) return;
      const state = importState;
      const currentStep = state.step === 'search' ? 'review' : state.step;
      const stepIndex = IMPORT_STEPS.findIndex(([key]) => key === currentStep);
      const steps = `<ol class="flex flex-wrap gap-2 mb-5 text-[11px]">${IMPORT_STEPS.map(([key, label], index) => `
        <li class="px-2.5 py-1 rounded-md ${index === stepIndex ? 'bg-yellow-400/10 text-yellow-400' : index < stepIndex ? 'text-zinc-300' : 'text-zinc-600'}">${index + 1}. ${label}</li>`).join('')}</ol>`;
      const message = state.message
        ? `<p class="text-xs mt-3 ${state.messageTone === 'error' ? 'text-red-400' : 'text-zinc-300'}" role="status">${escapeHTML(state.message)}</p>` : '';
      const card = 'bg-zinc-900/60 border border-zinc-800 rounded-xl p-5';
      let body = '';

      if (state.step === 'upload') {
        body = `<div class="${card} space-y-4">
          <ol class="list-decimal list-inside text-xs text-zinc-400 space-y-1">
            <li>Prepara un file CSV con una riga di intestazione (separatore virgola o punto e virgola).</li>
            <li>Per ogni film indica almeno il titolo e un voto da 1 a 10, oppure segnalo per la wishlist con «sì», «x» o «1».</li>
            <li>Se un film ha sia il voto sia la wishlist, viene salvato tra i votati.</li>
          </ol>
          <label class="block border-2 border-dashed border-zinc-700 hover:border-yellow-400 rounded-xl p-6 text-center cursor-pointer transition">
            <span class="block text-sm text-white font-semibold mb-1">Scegli il file CSV</span>
            <span class="block text-[11px] text-zinc-500">Massimo ${IMPORT_MAX_ROWS} film e 5 MB</span>
            <input type="file" accept=".csv,text/csv" class="sr-only" onchange="handleImportFile(this)">
          </label>
          <button onclick="downloadSampleCSV()" class="text-xs text-yellow-400 hover:underline">⬇ Scarica un CSV di esempio (titolo;anno;voto;note;wishlist)</button>
          ${message}
        </div>`;
      }

      if (state.step === 'map') {
        const options = (selected) => `<option value="">— Nessuna —</option>${state.headers.map((header, index) =>
          `<option value="${index}" ${selected === index ? 'selected' : ''}>${escapeHTML(header)}</option>`).join('')}`;
        const previewRows = state.rows.slice(0, 3);
        body = `<div class="${card}">
          <p class="text-xs text-zinc-400 mb-4">File <span class="text-white">${escapeHTML(state.fileName)}</span>: ${state.rows.length} righe. Indica quale colonna contiene ogni informazione.</p>
          <div class="grid sm:grid-cols-2 gap-3 mb-5">
            ${IMPORT_FIELDS.map((field) => `<label class="block">
              <span class="block text-[11px] font-semibold uppercase tracking-wider text-zinc-400 mb-1">${field.label} <span class="normal-case font-normal text-zinc-600">(${field.hint})</span></span>
              <select id="map-${field.key}" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-yellow-400">${options(state.mapping[field.key])}</select>
            </label>`).join('')}
          </div>
          <p class="text-[11px] text-zinc-500 mb-2">Prime righe del file:</p>
          <div class="overflow-x-auto mb-5 border border-zinc-800 rounded-lg">
            <table class="w-full text-[11px]">
              <thead class="bg-zinc-950 text-zinc-400"><tr>${state.headers.map((header) => `<th class="px-2.5 py-1.5 text-left font-semibold whitespace-nowrap">${escapeHTML(header)}</th>`).join('')}</tr></thead>
              <tbody>${previewRows.map((row) => `<tr class="border-t border-zinc-800">${state.headers.map((_, index) =>
                `<td class="px-2.5 py-1.5 text-zinc-300 whitespace-nowrap max-w-[14rem] truncate">${escapeHTML(row[index] ?? '')}</td>`).join('')}</tr>`).join('')}</tbody>
            </table>
          </div>
          <div class="flex flex-wrap gap-2">
            <button onclick="startImportSearch()" class="px-4 py-2.5 bg-yellow-400 text-black font-semibold text-xs rounded-lg hover:bg-yellow-300">Cerca i film su TMDB</button>
            <button onclick="resetImport()" class="px-4 py-2.5 bg-zinc-900 border border-zinc-700 text-xs text-zinc-200 rounded-lg hover:bg-zinc-800">Scegli un altro file</button>
          </div>
          ${message}
        </div>`;
      }

      if (state.step === 'search') {
        body = `<div class="${card}">
          <p id="import-progress-label" class="text-xs text-zinc-300 mb-3" role="status" aria-live="polite"></p>
          <div class="w-full h-2 bg-zinc-800 rounded-full overflow-hidden" role="progressbar" aria-label="Avanzamento ricerca" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
            <div id="import-progress-bar" class="h-full bg-yellow-400 transition-all duration-300" style="width: 0%"></div>
          </div>
          <p class="text-[11px] text-zinc-500 mt-3">La ricerca procede un po' alla volta per rispettare i limiti di TMDB. Puoi lasciare aperta questa pagina.</p>
          <button onclick="resetImport()" class="mt-4 px-4 py-2 bg-zinc-900 border border-zinc-700 text-xs text-zinc-200 rounded-lg hover:bg-zinc-800">Annulla</button>
        </div>`;
      }

      if (state.step === 'review') {
        const byStatus = (status) => state.entries.filter((entry) => entry.status === status);
        const found = byStatus('found');
        const doubts = byStatus('doubt');
        const missing = byStatus('missing');
        const skipped = byStatus('skipped');
        const ready = importItems().length;
        body = `<div class="${card} mb-5">
            <div class="grid grid-cols-3 gap-3 text-center mb-4">
              <div><p class="text-2xl font-extrabold text-green-400 font-mono">${found.length}</p><p class="text-[11px] text-zinc-400">Trovati</p></div>
              <div><p class="text-2xl font-extrabold text-amber-400 font-mono">${doubts.length}</p><p class="text-[11px] text-zinc-400">Dubbi</p></div>
              <div><p class="text-2xl font-extrabold text-red-400 font-mono">${missing.length}</p><p class="text-[11px] text-zinc-400">Non trovati</p></div>
            </div>
            ${state.ignored ? `<p class="text-[11px] text-zinc-500 mb-2">Righe ignorate: ${escapeHTML(state.ignoredReasons.join(', '))}.</p>` : ''}
            ${doubts.length || missing.length ? '<p class="text-[11px] text-zinc-500 mb-3">I film dubbi senza una scelta e quelli non trovati verranno saltati.</p>' : ''}
            <div class="flex flex-wrap gap-2">
              <button onclick="confirmImport()" ${state.saving || !ready ? 'disabled' : ''} class="px-4 py-2.5 bg-yellow-400 text-black font-semibold text-xs rounded-lg hover:bg-yellow-300">Conferma importazione (${ready} film)</button>
              <button onclick="resetImport()" ${state.saving ? 'disabled' : ''} class="px-4 py-2.5 bg-zinc-900 border border-zinc-700 text-xs text-zinc-200 rounded-lg hover:bg-zinc-800">Ricomincia</button>
            </div>
            ${message}
          </div>
          ${renderImportGroup('Dubbi', 'Abbiamo trovato più film possibili: scegli quello giusto.', doubts, 'text-amber-400')}
          ${renderImportGroup('Non trovati', 'Correggi il titolo (spesso funziona meglio il titolo originale) e premi Riprova, oppure salta il film.', missing, 'text-red-400')}
          ${renderImportGroup('Trovati', 'Questi film verranno importati.', found, 'text-green-400', found.length <= 200)}
          ${renderImportGroup('Saltati', 'Questi film non verranno importati.', skipped, 'text-zinc-400', false)}`;
      }

      if (state.step === 'done') {
        const result = state.result;
        body = `<div class="${card} text-center">
          <p class="text-2xl font-extrabold text-yellow-400 mb-2">${result.imported} film importati, ${result.skipped} saltati.</p>
          <p class="text-xs text-zinc-400 mb-5">${result.rated} tra i votati, ${result.watchlisted} nella watchlist.${result.merged > 0 ? ` ${result.merged} righe duplicate sono state unite.` : ''}</p>
          <div class="flex flex-wrap justify-center gap-2">
            <button onclick="switchTab('rated')" class="px-4 py-2.5 bg-yellow-400 text-black font-semibold text-xs rounded-lg hover:bg-yellow-300">Vai ai Votati</button>
            <button onclick="switchTab('watchlist')" class="px-4 py-2.5 bg-zinc-900 border border-zinc-700 text-xs text-zinc-200 rounded-lg hover:bg-zinc-800">Vai alla Watchlist</button>
            <button onclick="resetImport()" class="px-4 py-2.5 bg-zinc-900 border border-zinc-700 text-xs text-zinc-200 rounded-lg hover:bg-zinc-800">Importa un altro file</button>
          </div>
        </div>`;
      }

      container.innerHTML = steps + body;
      container.querySelectorAll('img').forEach((image) => image.addEventListener('error', () => {
        if (image.src !== EMPTY_POSTER) image.src = EMPTY_POSTER;
      }, { once: true }));
      if (state.step === 'search') updateImportProgress();
    }

    initAuth();
    loadTrending();
  </script>
</body>
</html>
