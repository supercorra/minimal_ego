    function normalizeText(value) {
      return String(value ?? '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
    }

    function detectDelimiter(text) {
      const firstLine = text.split(/\r?\n/, 1)[0] || '';
      let quoted = false;
      const counts = { ';': 0, ',': 0, '\t': 0 };
      for (const character of firstLine) {
        if (character === '"') quoted = !quoted;
        else if (!quoted && character in counts) counts[character]++;
      }
      const [best, count] = Object.entries(counts).sort((a, b) => b[1] - a[1])[0];
      return count > 0 ? best : ',';
    }

    function parseCSV(text, delimiter) {
      const rows = [];
      let row = [];
      let field = '';
      let quoted = false;
      for (let index = 0; index < text.length; index++) {
        const character = text[index];
        if (quoted) {
          if (character === '"' && text[index + 1] === '"') { field += '"'; index++; }
          else if (character === '"') quoted = false;
          else field += character;
        } else if (character === '"' && field.trim() === '') {
          quoted = true;
          field = '';
        } else if (character === delimiter) {
          row.push(field);
          field = '';
        } else if (character === '\n' || character === '\r') {
          if (character === '\r' && text[index + 1] === '\n') index++;
          row.push(field);
          rows.push(row);
          row = [];
          field = '';
        } else {
          field += character;
        }
      }
      if (field !== '' || row.length) {
        row.push(field);
        rows.push(row);
      }
      return rows.filter((cells) => cells.some((cell) => cell.trim() !== ''));
    }

    async function readCSVFile(file) {
      const buffer = await file.arrayBuffer();
      let text = new TextDecoder('utf-8').decode(buffer);
      // I file esportati da Excel su Windows spesso non sono in UTF-8.
      if (text.includes('�')) text = new TextDecoder('windows-1252').decode(buffer);
      return text.replace(/^﻿/, '');
    }

    function guessMapping(headers) {
      const normalized = headers.map(normalizeText);
      const mapping = {};
      const used = new Set();
      for (const exact of [true, false]) {
        IMPORT_FIELDS.forEach((field) => {
          if (mapping[field.key] !== undefined) return;
          const index = normalized.findIndex((header, position) => !used.has(position) && header
            && field.guesses.some((guess) => exact ? header === guess : header.includes(guess)));
          if (index >= 0) {
            mapping[field.key] = index;
            used.add(index);
          }
        });
      }
      return mapping;
    }

    async function handleImportFile(input) {
      const file = input.files?.[0];
      if (!file) return;
      ++importRun;
      importState = freshImportState();
      if (file.size > 5 * 1024 * 1024) {
        setImportMessage('Il file è troppo grande: il limite è 5 MB.');
        return renderImport();
      }
      try {
        const text = await readCSVFile(file);
        const rows = parseCSV(text, detectDelimiter(text));
        if (rows.length < 2) {
          setImportMessage('Il file deve contenere una riga di intestazione e almeno un film.');
          return renderImport();
        }
        if (rows.length - 1 > IMPORT_MAX_ROWS) {
          setImportMessage(`Il file contiene troppe righe: il limite è ${IMPORT_MAX_ROWS} film per importazione. Dividilo in più file.`);
          return renderImport();
        }
        importState.fileName = file.name;
        importState.headers = rows[0].map((header, index) => header.trim() || `Colonna ${index + 1}`);
        importState.rows = rows.slice(1);
        importState.mapping = guessMapping(importState.headers);
        importState.step = 'map';
      } catch {
        setImportMessage('Impossibile leggere il file. Assicurati che sia un CSV.');
      }
      renderImport();
    }

    function parseScore(value) {
      const text = String(value ?? '').trim().replace(',', '.');
      if (!text) return { score: null, invalid: false };
      const score = Number(text);
      if (!Number.isFinite(score) || score < 1 || score > 10) return { score: null, invalid: true };
      return { score: Math.round(score * 10) / 10, invalid: false };
    }

    function parseYear(value) {
      return String(value ?? '').match(/\b(18|19|20)\d{2}\b/)?.[0] || '';
    }

    function parseWishlist(value) {
      return ['sì', 'si', 'x', '1', 'true', 'yes', 'vero'].includes(String(value ?? '').trim().toLowerCase());
    }

    function readMappingFromForm() {
      const mapping = {};
      IMPORT_FIELDS.forEach((field) => {
        const value = document.getElementById(`map-${field.key}`).value;
        if (value !== '') mapping[field.key] = Number(value);
      });
      return mapping;
    }

    function buildEntries(mapping) {
      const cell = (row, key) => mapping[key] === undefined ? '' : String(row[mapping[key]] ?? '').trim();
      const entries = [];
      const reasons = { noTitle: 0, noData: 0, badScore: 0 };
      importState.rows.forEach((row, index) => {
        const title = cell(row, 'title').slice(0, 200);
        if (!title) return reasons.noTitle++;
        const { score, invalid } = parseScore(cell(row, 'score'));
        const wishlist = parseWishlist(cell(row, 'wishlist'));
        if (score === null && !wishlist) return invalid ? reasons.badScore++ : reasons.noData++;
        entries.push({ id: entries.length, row: index + 2, title, query: title, year: parseYear(cell(row, 'year')),
          score, wishlist, notes: cell(row, 'notes').slice(0, 5000), status: 'pending', movie: null, candidates: [], previousStatus: null, busy: false });
      });
      const ignoredReasons = [];
      if (reasons.noTitle) ignoredReasons.push(`${reasons.noTitle} senza titolo`);
      if (reasons.noData) ignoredReasons.push(`${reasons.noData} senza voto né wishlist`);
      if (reasons.badScore) ignoredReasons.push(`${reasons.badScore} con un voto non valido (deve essere tra 1 e 10)`);
      return { entries, ignored: reasons.noTitle + reasons.noData + reasons.badScore, ignoredReasons };
    }

    const delay = (milliseconds) => new Promise((resolve) => setTimeout(resolve, milliseconds));

    async function searchTMDB(title, year) {
      const base = `/search/movie?query=${encodeURIComponent(title)}`;
      for (let attempt = 0; attempt < 3; attempt++) {
        try {
          let results = [];
          if (year) results = (await apiFetch(`${base}&year=${year}`)).results || [];
          if (!results.length) results = (await apiFetch(base)).results || [];
          return results;
        } catch (error) {
          if (attempt === 2) throw error;
          await delay(1500 * (attempt + 1));
        }
      }
    }

    function classifyEntry(entry, results) {
      const yearOf = (movie) => (movie.release_date || '').slice(0, 4);
      const valid = results.filter((movie) => Number.isSafeInteger(movie.id) && movie.id > 0 && typeof movie.title === 'string' && movie.title.trim());
      const wanted = normalizeText(entry.query);
      const exact = valid.filter((movie) => normalizeText(movie.title) === wanted || normalizeText(movie.original_title) === wanted);
      const exactYear = entry.year ? exact.filter((movie) => yearOf(movie) === entry.year) : exact;
      const preferred = [...exactYear, ...exact, ...valid].filter((movie, index, list) => list.findIndex((other) => other.id === movie.id) === index);
      entry.candidates = preferred.slice(0, 6);
      entry.movie = null;
      if (!valid.length) entry.status = 'missing';
      else if (exactYear.length === 1 || valid.length === 1) {
        entry.status = 'found';
        entry.movie = exactYear.length === 1 ? exactYear[0] : valid[0];
      } else entry.status = 'doubt';
    }

    async function resolveEntry(entry) {
      try {
        classifyEntry(entry, await searchTMDB(entry.query, entry.year));
        entry.error = '';
      } catch (error) {
        entry.status = 'missing';
        entry.candidates = [];
        entry.error = error.message || 'Ricerca non riuscita.';
      }
    }

    async function startImportSearch() {
      const mapping = readMappingFromForm();
      importState.mapping = mapping;
      if (mapping.title === undefined) {
        setImportMessage('Scegli la colonna che contiene il titolo.');
        return renderImport();
      }
      if (mapping.score === undefined && mapping.wishlist === undefined) {
        setImportMessage('Scegli almeno la colonna del voto o quella della wishlist, altrimenti non c\'è niente da importare.');
        return renderImport();
      }
      const { entries, ignored, ignoredReasons } = buildEntries(mapping);
      if (!entries.length) {
        setImportMessage(`Nessuna riga da importare${ignoredReasons.length ? `: ${ignoredReasons.join(', ')}` : ''}.`);
        return renderImport();
      }
      Object.assign(importState, { entries, ignored, ignoredReasons, step: 'search', progress: 0, message: '' });
      renderImport();
      const run = ++importRun;
      let next = 0;
      const worker = async () => {
        while (next < entries.length && run === importRun) {
          const entry = entries[next++];
          await resolveEntry(entry);
          if (run !== importRun) return;
          importState.progress++;
          updateImportProgress();
          // Breve pausa per restare entro i limiti di richieste di TMDB.
          await delay(150);
        }
      };
      await Promise.all([worker(), worker(), worker()]);
      if (run !== importRun) return;
      importState.step = 'review';
      renderImport();
    }

    function updateImportProgress() {
      const total = importState.entries.length;
      const percent = total ? Math.round((importState.progress / total) * 100) : 0;
      const bar = document.getElementById('import-progress-bar');
      const label = document.getElementById('import-progress-label');
      if (bar) bar.style.width = `${percent}%`;
      if (bar) bar.parentElement.setAttribute('aria-valuenow', String(percent));
      if (label) label.textContent = `Ricerca su TMDB: ${importState.progress} di ${total} film (${percent}%)`;
    }

    function findEntry(entryId) {
      return importState.entries.find((entry) => entry.id === entryId);
    }

    function chooseCandidate(entryId, movieId) {
      const entry = findEntry(entryId);
      const movie = entry?.candidates.find((candidate) => candidate.id === movieId);
      if (!movie) return;
      entry.movie = movie;
      entry.status = 'found';
      renderImport();
    }

    function changeMatch(entryId) {
      const entry = findEntry(entryId);
      if (!entry) return;
      entry.status = entry.candidates.length ? 'doubt' : 'missing';
      entry.movie = null;
      renderImport();
    }

    function skipEntry(entryId) {
      const entry = findEntry(entryId);
      if (!entry || entry.status === 'skipped') return;
      entry.previousStatus = entry.status;
      entry.status = 'skipped';
      renderImport();
    }

    function restoreEntry(entryId) {
      const entry = findEntry(entryId);
      if (!entry) return;
      entry.status = entry.previousStatus || (entry.movie ? 'found' : entry.candidates.length ? 'doubt' : 'missing');
      renderImport();
    }

    async function retryEntry(entryId) {
      const entry = findEntry(entryId);
      const input = document.getElementById(`retry-${entryId}`);
      const query = input?.value.trim().slice(0, 200);
      if (!entry || !query || entry.busy) return;
      entry.query = query;
      entry.busy = true;
      renderImport();
      const run = importRun;
      await resolveEntry(entry);
      entry.busy = false;
      if (run !== importRun) return;
      renderImport();
      if (entry.status === 'missing') document.getElementById(`retry-${entryId}`)?.focus();
    }

    function importItems() {
      const byMovie = new Map();
      importState.entries.filter((entry) => entry.status === 'found' && entry.movie).forEach((entry) => {
        const previous = byMovie.get(entry.movie.id);
        if (previous && previous.score !== null && entry.score === null) return;
        const { id, title, poster_path, release_date, overview } = entry.movie;
        byMovie.set(id, {
          movie: { id, title, poster_path: poster_path || null, release_date: release_date || '', overview: overview || '' },
          score: entry.score,
          notes: entry.notes,
          watchlisted: entry.score === null && entry.wishlist,
        });
      });
      return [...byMovie.values()];
    }

    async function confirmImport() {
      if (importState.saving || !requireLogin()) return;
      const items = importItems();
      if (!items.length) {
        setImportMessage('Non ci sono film confermati da importare.');
        return renderImport();
      }
      importState.saving = true;
      setImportMessage(`Salvataggio: 0 di ${items.length} film...`, 'info');
      renderImport();
      const run = importRun;
      const result = { imported: 0, rated: 0, watchlisted: 0 };
      try {
        for (let start = 0; start < items.length; start += IMPORT_BATCH) {
          const saved = await fetchJSON('/api/library/import', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: items.slice(start, start + IMPORT_BATCH) }),
          });
          if (run !== importRun) return;
          result.imported += saved.imported;
          result.rated += saved.rated;
          result.watchlisted += saved.watchlisted;
          setImportMessage(`Salvataggio: ${Math.min(start + IMPORT_BATCH, items.length)} di ${items.length} film...`, 'info');
          renderImport();
        }
        const notImported = importState.entries.filter((entry) => entry.status !== 'found').length;
        importState.result = { ...result, skipped: importState.ignored + notImported,
          merged: importState.entries.filter((entry) => entry.status === 'found').length - items.length };
        importState.step = 'done';
        importState.message = '';
        loadLibrary();
      } catch (error) {
        const savedText = result.imported ? ` ${result.imported} film sono già stati salvati: puoi riprovare senza creare doppioni.` : '';
        setImportMessage(`${error.message || 'Importazione non riuscita.'}${savedText}`);
      } finally {
        importState.saving = false;
        if (run === importRun) renderImport();
      }
    }

    function downloadSampleCSV() {
      const content = '﻿titolo;anno;voto;note;wishlist\n'
        + 'Il Padrino;1972;9,5;Capolavoro assoluto;\n'
        + 'Parasite;2019;8;;\n'
        + 'La grande bellezza;2013;7,5;Fotografia splendida;\n'
        + 'Dune - Parte due;2024;;;sì\n'
        + 'Perfect Days;2023;;Consigliato da un amico;x\n';
      const url = URL.createObjectURL(new Blob([content], { type: 'text/csv;charset=utf-8' }));
      const link = document.createElement('a');
      link.href = url;
      link.download = 'esempio-minimal-ego.csv';
      document.body.appendChild(link);
      link.click();
      link.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    }

    function thumbURL(path) {
      return typeof path === 'string' && /^\/[a-zA-Z0-9_.-]+$/.test(path) ? `${TMDB_THUMB_URL}${path}` : EMPTY_POSTER;
    }

    function movieYear(movie) {
      return movie?.release_date ? movie.release_date.slice(0, 4) : (movie?.year ? String(movie.year) : 'N/D');
    }

    function entrySummary(entry) {
      const parts = [`Riga ${entry.row}: «${escapeHTML(entry.title)}»${entry.year ? ` (${escapeHTML(entry.year)})` : ''}`];
      parts.push(entry.score !== null ? `voto <span class="text-yellow-400 font-mono">${entry.score.toFixed(1)}</span>` : '<span class="text-blue-400">watchlist</span>');
      return parts.join(' · ');
    }

    const importButton = 'px-2.5 py-1 bg-zinc-900 border border-zinc-700 text-[11px] text-zinc-200 rounded-md hover:bg-zinc-800';

    function renderEntryRow(entry) {
      if (entry.status === 'found') {
        return `<li class="flex items-center gap-3 p-2.5 bg-zinc-900 border border-zinc-800 rounded-lg">
          <img src="${escapeHTML(thumbURL(entry.movie.poster_path))}" alt="" class="w-10 h-14 object-cover rounded bg-zinc-800 flex-none" loading="lazy">
          <div class="min-w-0 flex-1">
            <p class="text-xs font-semibold text-white truncate">${escapeHTML(entry.movie.title)} <span class="text-zinc-500 font-normal">(${escapeHTML(movieYear(entry.movie))})</span></p>
            <p class="text-[10px] text-zinc-500 truncate">${entrySummary(entry)}</p>
          </div>
          <div class="flex gap-1.5 flex-none">
            ${entry.candidates.length > 1 ? `<button onclick="changeMatch(${entry.id})" class="${importButton}">Cambia</button>` : ''}
            <button onclick="skipEntry(${entry.id})" class="${importButton}">Salta</button>
          </div>
        </li>`;
      }
      if (entry.status === 'doubt') {
        return `<li class="p-3 bg-zinc-900 border border-amber-500/30 rounded-lg">
          <div class="flex items-start justify-between gap-3 mb-2">
            <p class="text-[11px] text-zinc-300">${entrySummary(entry)}<br><span class="text-zinc-500">Quale di questi film è quello giusto?</span></p>
            <button onclick="skipEntry(${entry.id})" class="${importButton} flex-none">Salta</button>
          </div>
          <div class="grid grid-cols-3 sm:grid-cols-6 gap-2">
            ${entry.candidates.map((movie) => `<button onclick="chooseCandidate(${entry.id}, ${Number(movie.id)})" class="text-left bg-zinc-950 border border-zinc-800 rounded-md overflow-hidden hover:border-yellow-400 transition">
              <img src="${escapeHTML(thumbURL(movie.poster_path))}" alt="" class="w-full aspect-[2/3] object-cover bg-zinc-800" loading="lazy">
              <span class="block p-1.5 text-[10px] text-white leading-tight line-clamp-2">${escapeHTML(movie.title)}</span>
              <span class="block px-1.5 pb-1.5 text-[10px] text-zinc-500">${escapeHTML(movieYear(movie))}</span>
            </button>`).join('')}
          </div>
        </li>`;
      }
      if (entry.status === 'missing') {
        return `<li class="p-3 bg-zinc-900 border border-red-500/30 rounded-lg">
          <p class="text-[11px] text-zinc-300 mb-2">${entrySummary(entry)}${entry.error ? `<br><span class="text-red-400">${escapeHTML(entry.error)}</span>` : ''}</p>
          <div class="flex gap-2">
            <input id="retry-${entry.id}" value="${escapeHTML(entry.query)}" maxlength="200" aria-label="Correggi il titolo di riga ${entry.row}"
              onkeydown="if(event.key === 'Enter') retryEntry(${entry.id})"
              class="min-w-0 flex-1 bg-zinc-950 border border-zinc-800 rounded-md px-2.5 py-1.5 text-xs text-white focus:outline-none focus:border-yellow-400">
            <button onclick="retryEntry(${entry.id})" ${entry.busy ? 'disabled' : ''} class="px-2.5 py-1 bg-yellow-400 text-black font-semibold text-[11px] rounded-md hover:bg-yellow-300">${entry.busy ? 'Ricerca...' : 'Riprova'}</button>
            <button onclick="skipEntry(${entry.id})" class="${importButton}">Salta</button>
          </div>
        </li>`;
      }
      return `<li class="flex items-center justify-between gap-3 p-2.5 bg-zinc-900/50 border border-zinc-800 rounded-lg">
        <p class="text-[10px] text-zinc-500 truncate">${entrySummary(entry)}</p>
        <button onclick="restoreEntry(${entry.id})" class="${importButton} flex-none">Ripristina</button>
      </li>`;
    }

    function renderImportGroup(title, description, entries, tone, open = true) {
      if (!entries.length) return '';
      return `<details ${open ? 'open' : ''} class="mb-5">
        <summary class="cursor-pointer text-sm font-semibold ${tone} mb-1">${title} (${entries.length})</summary>
        <p class="text-[11px] text-zinc-500 mb-3">${description}</p>
        <ul class="space-y-2">${entries.map(renderEntryRow).join('')}</ul>
      </details>`;
    }

    function renderImport() {
      const container = document.getElementById('import-content');
      if (!container) return;
      const state = importState;
      const currentStep = state.step === 'search' ? 'review' : state.step;
      const stepIndex = IMPORT_STEPS.findIndex(([key]) => key === currentStep);
      const steps = `<ol class="flex flex-wrap gap-2 mb-5 text-[11px]">${IMPORT_STEPS.map(([key, label], index) => `
        <li class="px-2.5 py-1 rounded-md ${index === stepIndex ? 'bg-yellow-400/10 text-yellow-400' : index < stepIndex ? 'text-zinc-300' : 'text-zinc-600'}">${index + 1}. ${label}</li>`).join('')}</ol>`;
      const message = state.message
        ? `<p class="text-xs mt-3 ${state.messageTone === 'error' ? 'text-red-400' : 'text-zinc-300'}" role="status">${escapeHTML(state.message)}</p>` : '';
      const card = 'bg-zinc-900/60 border border-zinc-800 rounded-xl p-5';
      let body = '';

      if (state.step === 'upload') {
        body = `<div class="${card} space-y-4">
          <ol class="list-decimal list-inside text-xs text-zinc-400 space-y-1">
            <li>Prepara un file CSV con una riga di intestazione (separatore virgola o punto e virgola).</li>
            <li>Per ogni film indica almeno il titolo e un voto da 1 a 10, oppure segnalo per la wishlist con «sì», «x» o «1».</li>
            <li>Se un film ha sia il voto sia la wishlist, viene salvato tra i votati.</li>
          </ol>
          <label class="block border-2 border-dashed border-zinc-700 hover:border-yellow-400 rounded-xl p-6 text-center cursor-pointer transition">
            <span class="block text-sm text-white font-semibold mb-1">Scegli il file CSV</span>
            <span class="block text-[11px] text-zinc-500">Massimo ${IMPORT_MAX_ROWS} film e 5 MB</span>
            <input type="file" accept=".csv,text/csv" class="sr-only" onchange="handleImportFile(this)">
          </label>
          <button onclick="downloadSampleCSV()" class="text-xs text-yellow-400 hover:underline">⬇ Scarica un CSV di esempio (titolo;anno;voto;note;wishlist)</button>
          ${message}
        </div>`;
      }

      if (state.step === 'map') {
        const options = (selected) => `<option value="">— Nessuna —</option>${state.headers.map((header, index) =>
          `<option value="${index}" ${selected === index ? 'selected' : ''}>${escapeHTML(header)}</option>`).join('')}`;
        const previewRows = state.rows.slice(0, 3);
        body = `<div class="${card}">
          <p class="text-xs text-zinc-400 mb-4">File <span class="text-white">${escapeHTML(state.fileName)}</span>: ${state.rows.length} righe. Indica quale colonna contiene ogni informazione.</p>
          <div class="grid sm:grid-cols-2 gap-3 mb-5">
            ${IMPORT_FIELDS.map((field) => `<label class="block">
              <span class="block text-[11px] font-semibold uppercase tracking-wider text-zinc-400 mb-1">${field.label} <span class="normal-case font-normal text-zinc-600">(${field.hint})</span></span>
              <select id="map-${field.key}" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-yellow-400">${options(state.mapping[field.key])}</select>
            </label>`).join('')}
          </div>
          <p class="text-[11px] text-zinc-500 mb-2">Prime righe del file:</p>
          <div class="overflow-x-auto mb-5 border border-zinc-800 rounded-lg">
            <table class="w-full text-[11px]">
              <thead class="bg-zinc-950 text-zinc-400"><tr>${state.headers.map((header) => `<th class="px-2.5 py-1.5 text-left font-semibold whitespace-nowrap">${escapeHTML(header)}</th>`).join('')}</tr></thead>
              <tbody>${previewRows.map((row) => `<tr class="border-t border-zinc-800">${state.headers.map((_, index) =>
                `<td class="px-2.5 py-1.5 text-zinc-300 whitespace-nowrap max-w-[14rem] truncate">${escapeHTML(row[index] ?? '')}</td>`).join('')}</tr>`).join('')}</tbody>
            </table>
          </div>
          <div class="flex flex-wrap gap-2">
            <button onclick="startImportSearch()" class="px-4 py-2.5 bg-yellow-400 text-black font-semibold text-xs rounded-lg hover:bg-yellow-300">Cerca i film su TMDB</button>
            <button onclick="resetImport()" class="px-4 py-2.5 bg-zinc-900 border border-zinc-700 text-xs text-zinc-200 rounded-lg hover:bg-zinc-800">Scegli un altro file</button>
          </div>
          ${message}
        </div>`;
      }

      if (state.step === 'search') {
        body = `<div class="${card}">
          <p id="import-progress-label" class="text-xs text-zinc-300 mb-3" role="status" aria-live="polite"></p>
          <div class="w-full h-2 bg-zinc-800 rounded-full overflow-hidden" role="progressbar" aria-label="Avanzamento ricerca" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
            <div id="import-progress-bar" class="h-full bg-yellow-400 transition-all duration-300" style="width: 0%"></div>
          </div>
          <p class="text-[11px] text-zinc-500 mt-3">La ricerca procede un po' alla volta per rispettare i limiti di TMDB. Puoi lasciare aperta questa pagina.</p>
          <button onclick="resetImport()" class="mt-4 px-4 py-2 bg-zinc-900 border border-zinc-700 text-xs text-zinc-200 rounded-lg hover:bg-zinc-800">Annulla</button>
        </div>`;
      }

      if (state.step === 'review') {
        const byStatus = (status) => state.entries.filter((entry) => entry.status === status);
        const found = byStatus('found');
        const doubts = byStatus('doubt');
        const missing = byStatus('missing');
        const skipped = byStatus('skipped');
        const ready = importItems().length;
        body = `<div class="${card} mb-5">
            <div class="grid grid-cols-3 gap-3 text-center mb-4">
              <div><p class="text-2xl font-extrabold text-green-400 font-mono">${found.length}</p><p class="text-[11px] text-zinc-400">Trovati</p></div>
              <div><p class="text-2xl font-extrabold text-amber-400 font-mono">${doubts.length}</p><p class="text-[11px] text-zinc-400">Dubbi</p></div>
              <div><p class="text-2xl font-extrabold text-red-400 font-mono">${missing.length}</p><p class="text-[11px] text-zinc-400">Non trovati</p></div>
            </div>
            ${state.ignored ? `<p class="text-[11px] text-zinc-500 mb-2">Righe ignorate: ${escapeHTML(state.ignoredReasons.join(', '))}.</p>` : ''}
            ${doubts.length || missing.length ? '<p class="text-[11px] text-zinc-500 mb-3">I film dubbi senza una scelta e quelli non trovati verranno saltati.</p>' : ''}
            <div class="flex flex-wrap gap-2">
              <button onclick="confirmImport()" ${state.saving || !ready ? 'disabled' : ''} class="px-4 py-2.5 bg-yellow-400 text-black font-semibold text-xs rounded-lg hover:bg-yellow-300">Conferma importazione (${ready} film)</button>
              <button onclick="resetImport()" ${state.saving ? 'disabled' : ''} class="px-4 py-2.5 bg-zinc-900 border border-zinc-700 text-xs text-zinc-200 rounded-lg hover:bg-zinc-800">Ricomincia</button>
            </div>
            ${message}
          </div>
          ${renderImportGroup('Dubbi', 'Abbiamo trovato più film possibili: scegli quello giusto.', doubts, 'text-amber-400')}
          ${renderImportGroup('Non trovati', 'Correggi il titolo (spesso funziona meglio il titolo originale) e premi Riprova, oppure salta il film.', missing, 'text-red-400')}
          ${renderImportGroup('Trovati', 'Questi film verranno importati.', found, 'text-green-400', found.length <= 200)}
          ${renderImportGroup('Saltati', 'Questi film non verranno importati.', skipped, 'text-zinc-400', false)}`;
      }

      if (state.step === 'done') {
        const result = state.result;
        body = `<div class="${card} text-center">
          <p class="text-2xl font-extrabold text-yellow-400 mb-2">${result.imported} film importati, ${result.skipped} saltati.</p>
          <p class="text-xs text-zinc-400 mb-5">${result.rated} tra i votati, ${result.watchlisted} nella watchlist.${result.merged > 0 ? ` ${result.merged} righe duplicate sono state unite.` : ''}</p>
          <div class="flex flex-wrap justify-center gap-2">
            <button onclick="switchTab('rated')" class="px-4 py-2.5 bg-yellow-400 text-black font-semibold text-xs rounded-lg hover:bg-yellow-300">Vai ai Votati</button>
            <button onclick="switchTab('watchlist')" class="px-4 py-2.5 bg-zinc-900 border border-zinc-700 text-xs text-zinc-200 rounded-lg hover:bg-zinc-800">Vai alla Watchlist</button>
            <button onclick="resetImport()" class="px-4 py-2.5 bg-zinc-900 border border-zinc-700 text-xs text-zinc-200 rounded-lg hover:bg-zinc-800">Importa un altro file</button>
          </div>
        </div>`;
      }

      container.innerHTML = steps + body;
      container.querySelectorAll('img').forEach((image) => image.addEventListener('error', () => {
        if (image.src !== EMPTY_POSTER) image.src = EMPTY_POSTER;
      }, { once: true }));
      if (state.step === 'search') updateImportProgress();
    }

    initAuth();
    loadTrending();
  </script>
</body>
</html>
