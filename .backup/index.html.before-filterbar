<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Minimal Ego — v2</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { background-color: #0b0d10; color: #e5e7eb; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    .poster-glow:hover { box-shadow: 0 10px 25px -5px rgba(250, 204, 21, 0.15); }
    input[type=range]::-webkit-slider-thumb {
      -webkit-appearance: none;
      height: 20px;
      width: 20px;
      border-radius: 50%;
      background: #facc15;
      cursor: pointer;
    }
    input[type=range]::-moz-range-thumb { height: 20px; width: 20px; border: 0; border-radius: 50%; background: #facc15; cursor: pointer; }
    button:focus-visible { outline: 2px solid #facc15; outline-offset: 3px; }
    button:disabled { opacity: 0.5; cursor: wait; }
    [hidden] { display: none !important; }
  </style>
</head>
<body class="min-h-screen pb-24">

  <header class="border-b border-zinc-800/80 bg-zinc-950/80 backdrop-blur sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 py-3.5 flex flex-wrap gap-3 items-center justify-between">
      <div class="flex items-center gap-3">
        <span class="text-lg font-bold tracking-tight text-white">MINIMAL<span class="text-yellow-400">EGO</span></span>
        <span class="text-[10px] px-2 py-0.5 rounded bg-zinc-800 text-zinc-400 font-mono">v2.0</span>
      </div>
      <nav class="flex items-center gap-1.5 sm:gap-2" aria-label="Sezioni film">
        <button onclick="switchTab('discover')" id="tab-discover" aria-current="page" class="px-3 py-1.5 text-xs font-medium rounded-md bg-yellow-400/10 text-yellow-400">Feed</button>
        <button onclick="switchTab('awards')" id="tab-awards" class="px-3 py-1.5 text-xs font-medium rounded-md text-zinc-400 hover:text-white">Scopri</button>
        <button onclick="switchTab('watchlist')" id="tab-watchlist" class="px-3 py-1.5 text-xs font-medium rounded-md text-zinc-400 hover:text-white">Watchlist (<span id="count-watchlist">0</span>)</button>
        <button onclick="switchTab('rated')" id="tab-rated" class="px-3 py-1.5 text-xs font-medium rounded-md text-zinc-400 hover:text-white">Rated (<span id="count-rated">0</span>)</button>
        <button onclick="switchTab('import')" id="tab-import" hidden class="px-3 py-1.5 text-xs font-medium rounded-md text-zinc-400 hover:text-white">Importa</button>
      </nav>
      <div id="account-area" class="flex items-center gap-2 text-xs">
        <button onclick="openAuth('login')" id="btn-open-login" class="px-3 py-1.5 bg-yellow-400 text-black font-semibold rounded-md hover:bg-yellow-300">Accedi</button>
        <span id="account-email" hidden class="max-w-[12rem] truncate text-zinc-400"></span>
        <button onclick="handleLogout()" id="btn-logout" hidden class="px-3 py-1.5 bg-zinc-900 border border-zinc-700 text-zinc-200 rounded-md hover:bg-zinc-800">Esci</button>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 pt-6">
    <section id="search-section" class="mb-6 space-y-3">
      <div class="flex gap-2">
        <input type="search" id="search-input" aria-label="Cerca un film" maxlength="200" placeholder="Cerca un film su TMDB..."
          class="min-w-0 flex-1 bg-zinc-900 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm text-white focus:outline-none focus:border-yellow-400 transition"
          onkeydown="if(event.key === 'Enter') executeSearch()">
        <button onclick="executeSearch()" class="px-4 py-2.5 bg-yellow-400 text-black font-semibold text-xs rounded-lg hover:bg-yellow-300 transition">Cerca</button>
      </div>
      <div id="feed-filters" class="flex gap-2 overflow-x-auto pb-1 text-xs">
        <button onclick="loadFeed('all')" data-feed-filter="all" class="px-3 py-1 bg-zinc-800 text-zinc-300 rounded-md hover:bg-zinc-700 whitespace-nowrap">Tutti</button>
        <button onclick="loadFeed('upcoming')" data-feed-filter="upcoming" class="px-3 py-1 bg-zinc-900 border border-zinc-800 text-zinc-400 rounded-md hover:text-white whitespace-nowrap">In uscita</button>
        <button onclick="loadFeed('recent')" data-feed-filter="recent" class="px-3 py-1 bg-zinc-900 border border-zinc-800 text-zinc-400 rounded-md hover:text-white whitespace-nowrap">Ultimi 6 mesi</button>
        <button onclick="loadFeed('2026')" data-feed-filter="2026" class="px-3 py-1 bg-zinc-900 border border-zinc-800 text-zinc-400 rounded-md hover:text-white whitespace-nowrap">2026</button>
        <button onclick="loadFeed('2025')" data-feed-filter="2025" class="px-3 py-1 bg-zinc-900 border border-zinc-800 text-zinc-400 rounded-md hover:text-white whitespace-nowrap">2025</button>
        <button onclick="loadFeed('2024')" data-feed-filter="2024" class="px-3 py-1 bg-zinc-900 border border-zinc-800 text-zinc-400 rounded-md hover:text-white whitespace-nowrap">2024</button>
        <button onclick="loadFeed('2023')" data-feed-filter="2023" class="px-3 py-1 bg-zinc-900 border border-zinc-800 text-zinc-400 rounded-md hover:text-white whitespace-nowrap">2023</button>
        <button onclick="loadFeed('2022')" data-feed-filter="2022" class="px-3 py-1 bg-zinc-900 border border-zinc-800 text-zinc-400 rounded-md hover:text-white whitespace-nowrap">2022</button>
      </div>
      <div id="library-filters" style="display:none" class="flex items-center gap-2 overflow-x-auto pb-1 text-xs"></div>
      <div id="awards-filters" style="display:none" class="flex items-center gap-2 overflow-x-auto pb-1 text-xs">
        <button onclick="loadAwards('all')" data-award="all" class="px-3 py-1 bg-zinc-800 text-zinc-300 rounded-md hover:bg-zinc-700 whitespace-nowrap">Tutti i premi</button>
        <button onclick="loadAwards('oscar')" data-award="oscar" class="px-3 py-1 bg-zinc-900 border border-zinc-800 text-zinc-400 rounded-md hover:text-white whitespace-nowrap">Oscar</button>
        <button onclick="loadAwards('cannes')" data-award="cannes" class="px-3 py-1 bg-zinc-900 border border-zinc-800 text-zinc-400 rounded-md hover:text-white whitespace-nowrap">Cannes</button>
        <button onclick="loadAwards('venice')" data-award="venice" class="px-3 py-1 bg-zinc-900 border border-zinc-800 text-zinc-400 rounded-md hover:text-white whitespace-nowrap">Venezia</button>
        <button onclick="loadAwards('berlin')" data-award="berlin" class="px-3 py-1 bg-zinc-900 border border-zinc-800 text-zinc-400 rounded-md hover:text-white whitespace-nowrap">Berlino</button>
        <button onclick="loadAwards('donatello')" data-award="donatello" class="px-3 py-1 bg-zinc-900 border border-zinc-800 text-zinc-400 rounded-md hover:text-white whitespace-nowrap">David</button>
        <button onclick="loadAwards('sundance')" data-award="sundance" class="px-3 py-1 bg-zinc-900 border border-zinc-800 text-zinc-400 rounded-md hover:text-white whitespace-nowrap">Sundance</button>
        <select id="awards-year" onchange="loadAwards(awardsFilter)" aria-label="Anno" class="px-2 py-1 bg-zinc-900 border border-zinc-800 text-zinc-300 rounded-md"><option value="all">Tutti gli anni</option><option>2026</option><option>2025</option><option>2024</option><option>2023</option><option>2022</option></select>
      </div>
    </section>
    <div id="search-status" class="text-xs text-zinc-500 mb-4" role="status" aria-live="polite"></div>
    <div id="library-status" class="text-xs text-amber-400 mb-4" role="status" aria-live="polite"></div>
    <div id="movie-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4"></div>
    <section id="import-section" hidden class="max-w-4xl" aria-labelledby="import-title">
      <h2 id="import-title" class="text-base font-bold text-white mb-1">Importa i tuoi film da CSV</h2>
      <p class="text-xs text-zinc-400 mb-5">Carica un file con i film visti, i voti e la wishlist. Prima di salvare vedrai un'anteprima e potrai correggere i film non riconosciuti.</p>
      <div id="import-content"></div>
    </section>
    <p class="mt-8 text-[10px] text-zinc-500">Watchlist, voti e note sono salvati su Netlify e associati al tuo account. Le selezioni festival sono ricerche esemplificative, non archivi completi.</p>
    <p class="mt-2 text-[10px] text-zinc-500">Dati e immagini forniti da TMDB. Questo prodotto utilizza l'API TMDB ma non è approvato o certificato da TMDB.</p>
  </main>

  <div id="rating-drawer" role="dialog" aria-modal="true" aria-labelledby="drawer-title" aria-hidden="true" inert
    class="fixed inset-y-0 right-0 w-full sm:w-96 bg-zinc-950 border-l border-zinc-800 p-6 z-50 transform translate-x-full transition-transform duration-300 flex flex-col justify-between shadow-2xl overflow-y-auto">
    <div>
      <div class="flex justify-between items-start mb-4">
        <h3 id="drawer-title" class="font-bold text-base text-white line-clamp-1">Dettagli Film</h3>
        <button id="drawer-close" onclick="closeDrawer()" aria-label="Chiudi dettagli" class="text-zinc-500 hover:text-white text-lg">✕</button>
      </div>
      <p id="drawer-meta" class="text-[11px] text-zinc-500 -mt-2 mb-3" hidden></p>
      <img id="drawer-poster" alt="Locandina del film" class="w-full h-44 object-cover rounded-lg mb-4 bg-zinc-900 border border-zinc-800">
      <p id="drawer-overview" class="text-xs text-zinc-400 mb-6 line-clamp-3 leading-relaxed"></p>
      <div class="space-y-4">
        <div class="flex justify-between items-baseline">
          <label for="rating-slider" class="text-xs font-semibold uppercase tracking-wider text-zinc-400">Il tuo voto</label>
          <span id="rating-display" class="text-3xl font-extrabold text-yellow-400 font-mono">7.5</span>
        </div>
        <input type="range" id="rating-slider" min="1.0" max="10.0" step="0.1" value="7.5"
          class="w-full h-1.5 bg-zinc-800 rounded-lg appearance-none cursor-pointer" oninput="updateSliderDisplay(this.value)">
        <div class="grid grid-cols-4 gap-1.5 pt-1">
          <button onclick="adjustRating(-0.5)" class="py-1 bg-zinc-900 border border-zinc-800 rounded text-xs text-zinc-300 hover:border-zinc-700">-0.5</button>
          <button onclick="adjustRating(-0.1)" class="py-1 bg-zinc-900 border border-zinc-800 rounded text-xs text-zinc-300 hover:border-zinc-700">-0.1</button>
          <button onclick="adjustRating(0.1)" class="py-1 bg-zinc-900 border border-zinc-800 rounded text-xs text-zinc-300 hover:border-zinc-700">+0.1</button>
          <button onclick="adjustRating(0.5)" class="py-1 bg-zinc-900 border border-zinc-800 rounded text-xs text-zinc-300 hover:border-zinc-700">+0.5</button>
        </div>
        <textarea id="drawer-notes" aria-label="Note personali" maxlength="5000" placeholder="Note personali, regia, sceneggiatura..." rows="3"
          class="w-full mt-4 bg-zinc-900 border border-zinc-800 rounded-lg p-3 text-xs text-white focus:outline-none focus:border-yellow-400"></textarea>
      </div>
    </div>
    <div class="pt-4 mt-4 border-t border-zinc-800">
      <p id="drawer-status" class="text-xs text-amber-400 mb-3" role="status" aria-live="polite"></p>
      <div class="flex gap-2">
        <button onclick="saveRating()" id="btn-save-rating" class="flex-1 py-2.5 bg-yellow-400 text-black font-semibold text-xs rounded-lg hover:bg-yellow-300 transition">Salva Voto</button>
        <button onclick="toggleWatchlistCurrent()" id="btn-watchlist-drawer" class="px-4 py-2.5 bg-zinc-900 border border-zinc-700 text-xs text-zinc-200 rounded-lg hover:bg-zinc-800">+ Watchlist</button>
      </div>
    </div>
  </div>

  <div id="auth-modal" role="dialog" aria-modal="true" aria-labelledby="auth-title" aria-hidden="true" inert hidden
    class="fixed inset-0 z-[60] flex items-center justify-center bg-black/70 backdrop-blur-sm p-4" onclick="if(event.target === this) closeAuth()">
    <div class="w-full max-w-sm bg-zinc-950 border border-zinc-800 rounded-xl p-6 shadow-2xl">
      <div class="flex justify-between items-start mb-1">
        <h3 id="auth-title" class="font-bold text-base text-white">Accedi</h3>
        <button id="auth-close" onclick="closeAuth()" aria-label="Chiudi" class="text-zinc-500 hover:text-white text-lg">✕</button>
      </div>
      <p id="auth-subtitle" class="text-xs text-zinc-400 mb-5"></p>
      <form id="auth-form" class="space-y-3" onsubmit="event.preventDefault(); submitAuth()" novalidate>
        <div id="auth-field-email">
          <label for="auth-email" class="block text-[11px] font-semibold uppercase tracking-wider text-zinc-400 mb-1">Email</label>
          <input type="email" id="auth-email" autocomplete="email" maxlength="254"
            class="w-full bg-zinc-900 border border-zinc-800 rounded-lg px-3 py-2.5 text-sm text-white focus:outline-none focus:border-yellow-400">
        </div>
        <div id="auth-field-password">
          <label for="auth-password" id="auth-password-label" class="block text-[11px] font-semibold uppercase tracking-wider text-zinc-400 mb-1">Password</label>
          <input type="password" id="auth-password" autocomplete="current-password" maxlength="200"
            class="w-full bg-zinc-900 border border-zinc-800 rounded-lg px-3 py-2.5 text-sm text-white focus:outline-none focus:border-yellow-400">
        </div>
        <p id="auth-message" class="text-xs min-h-[1rem]" role="status" aria-live="polite"></p>
        <button type="submit" id="auth-submit" class="w-full py-2.5 bg-yellow-400 text-black font-semibold text-xs rounded-lg hover:bg-yellow-300 transition">Accedi</button>
      </form>
      <div id="auth-links" class="mt-4 flex flex-col gap-2 text-xs text-zinc-400"></div>
    </div>
  </div>

  <script src="/auth.js"></script>
  <script>
    const TMDB_IMG_URL = "https://image.tmdb.org/t/p/w500";
    const EMPTY_POSTER = "data:image/svg+xml," + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" width="500" height="750" viewBox="0 0 500 750"><rect width="500" height="750" fill="#18181b"/><text x="250" y="375" text-anchor="middle" fill="#71717a" font-family="sans-serif" font-size="24">Locandina non disponibile</text></svg>');
    let currentMovies = [];
    let selectedMovie = null;
    let library = { watchlist: [], ratings: {}, movies: [] };
    let activeTab = 'discover';
    let libraryReady = false;
    let saving = false;
    let searchRequest = 0;
    let previousFocus = null;
    let currentUser = null;
    let feedFilter = 'all';
    let ratedSort = 'score';
    let ratedYear = 'all';
    let watchlistSort = 'added';
    let awardsFilter = 'all';
    let awardsHidden = 0;
    const Auth = window.MinimalEgoAuth;

    async function fetchJSON(url, options = {}) {
      const response = await fetch(url, { credentials: 'same-origin', ...options });
      let data;
      try {
        data = await response.json();
      } catch {
        throw new Error('Risposta del server non valida. Apri il sito tramite Netlify.');
      }
      if (response.status === 401 && currentUser) {
        throw new Error('La sessione è scaduta. Esci e accedi di nuovo per continuare.');
      }
      if (!response.ok) throw new Error(data.error || 'Richiesta non riuscita. Riprova.');
      return data;
    }

    async function apiFetch(endpoint) {
      return fetchJSON(`/api/tmdb${endpoint}`);
    }

    async function loadCatalog(endpoint, loading, success) {
      activeTab = 'discover';
      updateTabs();
      const requestId = ++searchRequest;
      setStatus(loading);
      const grid = document.getElementById('movie-grid');
      grid.setAttribute('aria-busy', 'true');
      grid.innerHTML = Array.from({ length: 6 }, () => '<div class="rounded-lg border border-zinc-800 bg-zinc-900 animate-pulse"><div class="aspect-[2/3] bg-zinc-800"></div><div class="h-16"></div></div>').join('');
      try {
        const data = await apiFetch(endpoint);
        if (requestId !== searchRequest || activeTab !== 'discover') return;
        currentMovies = Array.isArray(data.results) ? data.results : [];
        renderActiveMovies();
        setStatus(typeof success === 'function' ? success(currentMovies.length) : success);
      } catch (error) {
        if (requestId !== searchRequest || activeTab !== 'discover') return;
        currentMovies = [];
        renderActiveMovies();
        setStatus(error.message || 'Errore di caricamento.');
      } finally {
        if (requestId === searchRequest) grid.removeAttribute('aria-busy');
      }
    }

    function updateFeedButtons() {
      document.querySelectorAll('[data-feed-filter]').forEach((button) => button.className = button.dataset.feedFilter === feedFilter ? 'px-3 py-1 bg-zinc-800 text-zinc-300 rounded-md hover:bg-zinc-700 whitespace-nowrap' : 'px-3 py-1 bg-zinc-900 border border-zinc-800 text-zinc-400 rounded-md hover:text-white whitespace-nowrap');
    }

    function loadFeed(filter = 'all') {
      feedFilter = filter; updateFeedButtons();
      const today = new Date().toISOString().slice(0, 10);
      const params = new URLSearchParams({ sort_by: 'primary_release_date.desc', 'vote_count.gte': '20' });
      let label = 'Tutti i film';
      if (filter === 'upcoming') { params.set('primary_release_date.gte', today); params.set('sort_by', 'primary_release_date.asc'); label = 'Film in uscita'; }
      else if (filter === 'recent') { const d = new Date(); d.setMonth(d.getMonth() - 6); params.set('primary_release_date.gte', d.toISOString().slice(0,10)); label = 'Film usciti negli ultimi 6 mesi'; }
      else if (/^20\d{2}$/.test(filter)) { params.set('primary_release_date.gte', `${filter}-01-01`); params.set('primary_release_date.lte', `${filter}-12-31`); label = `Film del ${filter}`; }
      return loadCatalog(`/discover/movie?${params}`, `Caricamento: ${label.toLowerCase()}...`, label);
    }

    function loadTrending() { return loadFeed('all'); }

    async function loadAwards(award = 'all') {
      awardsFilter = award;
      document.querySelectorAll('[data-award]').forEach((button) => button.className = button.dataset.award === award ? 'px-3 py-1 bg-zinc-800 text-zinc-300 rounded-md hover:bg-zinc-700 whitespace-nowrap' : 'px-3 py-1 bg-zinc-900 border border-zinc-800 text-zinc-400 rounded-md hover:text-white whitespace-nowrap');
      const year = document.getElementById('awards-year').value;
      const requestId = ++searchRequest;
      setStatus('Caricamento film premiati...');
      try {
        const data = await fetchJSON(`/api/awards?award=${encodeURIComponent(award)}&year=${encodeURIComponent(year)}`);
        if (requestId !== searchRequest || activeTab !== 'awards') return;
        currentMovies = Array.isArray(data.results) ? data.results : [];
        const shown = visibleMovies().length;
        renderActiveMovies();
        const hidden = currentMovies.length - shown;
        setStatus(`${shown} film premiati.${hidden > 0 ? ` ${hidden} nascosti perché già nella tua libreria.` : ''}${data.missing ? ` ${data.missing} non trovati su TMDB.` : ''}`);
      } catch (error) {
        if (requestId !== searchRequest || activeTab !== 'awards') return;
        currentMovies = []; renderActiveMovies(); setStatus(error.message || 'Errore di caricamento.');
      }
    }

    function renderLibraryFilters() {
      const box = document.getElementById('library-filters');
      const select = (id, handler, options, value) => `<select id="${id}" onchange="${handler}" class="px-2 py-1 bg-zinc-900 border border-zinc-800 text-zinc-300 rounded-md">${options.map(([v, l]) => `<option value="${v}" ${v === value ? 'selected' : ''}>${l}</option>`).join('')}</select>`;
      if (activeTab === 'rated') {
        const years = [0, 1, 2, 3, 4].map((i) => String(new Date().getFullYear() - i));
        box.innerHTML = '<span class="text-zinc-500">Ordina</span>' + select('rated-sort', "ratedSort=this.value;renderActiveMovies()", [['score', 'Punteggio'], ['director', 'Regista']], ratedSort)
          + '<span class="text-zinc-500">Voti</span>' + select('rated-year', "ratedYear=this.value;renderActiveMovies()", [['all', 'All time'], ...years.map((y) => [y, y])], ratedYear);
      } else if (activeTab === 'watchlist') {
        box.innerHTML = '<span class="text-zinc-500">Ordina</span>' + select('watchlist-sort', "watchlistSort=this.value;renderActiveMovies()", [['added', 'Data di aggiunta'], ['tmdb', 'Rating TMDB'], ['year', 'Anno']], watchlistSort);
      }
    }

    function updateFilterBars() {
      document.getElementById('feed-filters').style.display = activeTab === 'discover' ? 'flex' : 'none';
      document.getElementById('awards-filters').style.display = activeTab === 'awards' ? 'flex' : 'none';
      document.getElementById('library-filters').style.display = ['rated', 'watchlist'].includes(activeTab) ? 'flex' : 'none';
      document.getElementById('search-section').hidden = activeTab === 'import';
      renderLibraryFilters();
    }

    function loadFestival(festival) {
      const query = festival === 'Cannes' ? 'Anora' : 'The Room Next Door';
      return loadCatalog(`/search/movie?query=${encodeURIComponent(query)}&language=it-IT`,
        `Caricamento selezione ${festival}...`, `Selezione esemplificativa ${festival}: ${query}.`);
    }

    function executeSearch() {
      const query = document.getElementById('search-input').value.trim();
      if (!query) return loadTrending();
      return loadCatalog(`/search/movie?query=${encodeURIComponent(query)}&language=it-IT&include_adult=false`,
        `Ricerca: "${query}"...`, (count) => `Trovati ${count} risultati.`);
    }

    function setStatus(text) {
      document.getElementById('search-status').textContent = text;
    }

    function escapeHTML(value) {
      return String(value ?? '').replace(/[&<>"']/g, (character) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
      })[character]);
    }

    function posterURL(path) {
      return typeof path === 'string' && /^\/[a-zA-Z0-9_.-]+$/.test(path) ? `${TMDB_IMG_URL}${path}` : EMPTY_POSTER;
    }

    function visibleMovies() {
      if (activeTab === 'watchlist') {
        const list = library.movies.filter((movie) => library.watchlist.includes(movie.id));
        return list.sort((a, b) => watchlistSort === 'tmdb' ? Number(b.external_rating || b.vote_average || 0) - Number(a.external_rating || a.vote_average || 0) : watchlistSort === 'year' ? Number(b.year || movieYear(b) || 0) - Number(a.year || movieYear(a) || 0) : new Date(b.added_at || 0) - new Date(a.added_at || 0));
      }
      if (activeTab === 'rated') {
        let list = library.movies.filter((movie) => library.ratings[movie.id]);
        if (ratedYear !== 'all') list = list.filter((movie) => String(movie.watched_at || movie.added_at || '').slice(0, 4) === ratedYear);
        return list.sort((a, b) => ratedSort === 'director' ? String(a.director || 'zzz').localeCompare(String(b.director || 'zzz')) || Number(library.ratings[b.id]?.score || 0) - Number(library.ratings[a.id]?.score || 0) : Number(library.ratings[b.id]?.score || 0) - Number(library.ratings[a.id]?.score || 0));
      }
      if (activeTab === 'awards') return currentMovies.filter((movie) => !library.watchlist.includes(movie.id) && !library.ratings[movie.id]);
      return currentMovies;
    }

    function renderActiveMovies() {
      renderMovies(visibleMovies());
    }

    function renderMovies(list) {
      const grid = document.getElementById('movie-grid');
      grid.innerHTML = '';
      updateCounters();
