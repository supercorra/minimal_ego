    async function initAuth() {
      if (!Auth) {
        showNotice('Il sistema di accesso non è disponibile. Ricarica la pagina.');
        return;
      }
      Auth.onAuthChange((event, user) => {
        if (event === 'logout') setCurrentUser(null);
        else if (user) setCurrentUser(user);
      });
      const hadCallback = /(confirmation|recovery|invite|email_change)_token=|access_token=|error=/.test(window.location.hash);
      let callback = null;
      try {
        callback = await Auth.handleAuthCallback();
      } catch (error) {
        if (hadCallback) openAuth('login', 'Il link non è valido o è scaduto. Accedi o richiedi un nuovo link.', 'error');
      }
      if (hadCallback) history.replaceState(null, '', window.location.pathname + window.location.search);
      setCurrentUser(callback?.user || await Auth.getUser());
      if (callback?.type === 'confirmation') showNotice("Email confermata. Hai effettuato l'accesso.");
      if (callback?.type === 'email_change') showNotice('Indirizzo email aggiornato.');
      if (callback?.type === 'recovery') openAuth('reset');
      if (callback?.type === 'invite' && callback.token) {
        inviteToken = callback.token;
        openAuth('invite');
      }
    }

