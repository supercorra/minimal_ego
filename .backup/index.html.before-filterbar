    function authErrorMessage(error) {
      if (Auth && error instanceof Auth.MissingIdentityError) return 'Il sistema di accesso non è attivo su questo sito. Riprova più tardi.';
      const text = String(error?.message || '').toLowerCase();
      const status = error?.status;
      if (text.includes('not confirmed')) return "Devi prima confermare l'email: controlla la tua casella di posta e apri il link che ti abbiamo inviato.";
      if (text.includes('already') || text.includes('registered')) return 'Esiste già un account con questa email. Prova ad accedere.';
      if (status === 403 || text.includes('signups not allowed')) return 'Le registrazioni non sono attive in questo momento.';
      if (status === 429 || text.includes('rate limit') || text.includes('too many')) return 'Troppi tentativi. Attendi qualche minuto e riprova.';
      if (text.includes('password') && (text.includes('short') || text.includes('weak') || text.includes('characters'))) return 'La password è troppo debole: usa almeno 8 caratteri.';
      if (authMode === 'login' && (status === 400 || status === 401 || text.includes('invalid') || text.includes('no user'))) return 'Email o password non corretti.';
      if (text.includes('token') || text.includes('expired')) return 'Il link non è valido o è scaduto. Richiedine uno nuovo.';
      if (text.includes('fetch') || text.includes('network')) return 'Impossibile contattare il servizio di accesso. Controlla la connessione e riprova.';
      return 'Operazione non riuscita. Riprova.';
    }

    async function submitAuth() {
      if (authBusy || !Auth) return;
      const config = AUTH_MODES[authMode];
      const email = document.getElementById('auth-email').value.trim();
      const password = document.getElementById('auth-password').value;
      if (config.email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return setAuthMessage('Inserisci un indirizzo email valido.', 'error');
      if (authMode === 'login' && !password) return setAuthMessage('Inserisci la password.', 'error');
      if (config.password && authMode !== 'login' && password.length < 8) return setAuthMessage('La password deve contenere almeno 8 caratteri.', 'error');
      authBusy = true;
      const submit = document.getElementById('auth-submit');
      submit.disabled = true;
      setAuthMessage('Attendi...');
      try {
        if (authMode === 'login') {
          setCurrentUser(await Auth.login(email, password));
          closeAuth();
          showNotice(`Bentornato, ${currentUser?.email || ''}.`);
        } else if (authMode === 'signup') {
          const user = await Auth.signup(email, password);
          if (user?.confirmedAt) {
            setCurrentUser(user);
            closeAuth();
            showNotice('Account creato. Hai effettuato l\'accesso.');
          } else {
            openAuth('login', `Controlla la tua email per confermare l'account: abbiamo inviato un link a ${email}.`, 'success');
            document.getElementById('auth-email').value = email;
          }
        } else if (authMode === 'forgot') {
          await Auth.requestPasswordRecovery(email);
          setAuthMessage('Se l\'email è registrata, riceverai a breve un link per reimpostare la password.', 'success');
        } else if (authMode === 'reset') {
          setCurrentUser(await Auth.updateUser({ password }));
          closeAuth();
          showNotice('Password aggiornata. Hai effettuato l\'accesso.');
        } else if (authMode === 'invite') {
          setCurrentUser(await Auth.acceptInvite(inviteToken, password));
          inviteToken = null;
          closeAuth();
          showNotice('Account attivato. Benvenuto!');
        }
      } catch (error) {
        setAuthMessage(authErrorMessage(error), 'error');
      } finally {
        authBusy = false;
        submit.disabled = false;
      }
    }

