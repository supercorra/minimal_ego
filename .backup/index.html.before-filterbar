        || library.movies.find((movie) => movie.id === movieId);
    }

    function openDrawer(movieId) {
      selectedMovie = findMovie(movieId);
      if (!selectedMovie) return;
      previousFocus = document.activeElement;
      document.getElementById('drawer-title').textContent = selectedMovie.title;
      document.getElementById('drawer-overview').textContent = selectedMovie.overview || 'Nessuna sinossi disponibile.';
      const saved = library.movies.find((movie) => movie.id === movieId) || selectedMovie;
      const personal = library.ratings[movieId] || {};
      const preferences = { loved: 'Amato', liked: 'Piaciuto', disliked: 'Non piaciuto' };
      const meta = [
        movieYear(saved) !== 'N/D' ? movieYear(saved) : '',
        saved.director ? `regia di ${saved.director}` : '',
        saved.runtime_minutes ? `${saved.runtime_minutes} min` : '',
        saved.genres || '',
        personal.watched_at ? `visto il ${new Date(`${personal.watched_at}T00:00:00`).toLocaleDateString('it-IT')}` : '',
        preferences[personal.preference] || '',
      ].filter(Boolean).join(' · ');
      const metaElement = document.getElementById('drawer-meta');
      metaElement.textContent = meta;
      metaElement.hidden = !meta;
      const poster = document.getElementById('drawer-poster');
      poster.src = posterURL(selectedMovie.poster_path);
      poster.alt = `Locandina: ${selectedMovie.title}`;
